+from __future__ import annotations
+
+import numpy as np
+
+from sweagent.agent.algorithm.matrix_profile import MatrixProfileBasedBrain, StepFeaturizer
+
+
+def make_action(
+    tool: str,
+    index: int,
+    *,
+    observation: str = "",
+    has_error: bool = False,
+) -> dict:
+    return {
+        "tool": tool,
+        "args": {"index": index % 3},
+        "raw_action": f"{tool} {index % 3}",
+        "thought": "think" * (index % 3 + 1),
+        "observation": observation or "output" * (index % 3 + 1),
+        "execution_time": float(index % 3 + 1),
+        "has_error": has_error,
+    }
+
+
+def test_history_is_reencoded_in_one_shared_scalar_space() -> None:
+    featurizer = StepFeaturizer()
+    first = featurizer.extract(make_action("open", 0), has_error=False)
+    different = featurizer.extract(make_action("edit", 1), has_error=False)
+    repeated = featurizer.extract(make_action("open", 0), has_error=False)
+
+    encoded = featurizer.transform_history([first, different, repeated])
+
+    assert all(vector.shape == (36,) for vector in encoded)
+    assert np.array_equal(encoded[0], encoded[2])
+
+
+def test_brain_emits_all_four_event_types() -> None:
+    brain = MatrixProfileBasedBrain(window_sizes=(3,), min_actions_before_loop=0)
+    event_types = []
+
+    for index, tool in enumerate(("search", "edit", "bash-python") * 3):
+        event_types.extend(event["type"] for event in brain.analyze(make_action(tool, index)))
+
+    duplicate = make_action("pwd", 0)
+    brain.analyze(duplicate)
+    event_types.extend(event["type"] for event in brain.analyze(duplicate))
+    event_types.extend(
+        event["type"]
+        for event in brain.analyze(
+            make_action(
+                "bash-python",
+                1,
+                observation="Traceback (most recent call last):",
+            )
+        )
+    )
+
+    assert {"duplicate_action", "failed_action", "loop_action", "macro_candidate"} <= set(event_types)
+
+
+def test_loop_event_contains_representative_evidence() -> None:
+    brain = MatrixProfileBasedBrain(window_sizes=(3,), min_actions_before_loop=0)
+    loop = None
+
+    for index, tool in enumerate(("search", "open", "edit") * 3):
+        for event in brain.analyze(make_action(tool, index)):
+            if event["type"] == "loop_action":
+                loop = event
+
+    assert loop is not None
+    assert loop["window_starts"] == [0, 3, 6]
+    assert len(loop["representative_actions"]) == 3
+    assert loop["representative_start"] in loop["window_starts"]
+
+
+def test_offline_brain_reemits_a_qualifying_loop() -> None:
+    brain = MatrixProfileBasedBrain(window_sizes=(3,), min_actions_before_loop=0, offline=True)
+
+    for index, tool in enumerate(("search", "open", "edit") * 3):
+        brain.analyze(make_action(tool, index))
+
+    profiles = brain._update_current_profiles()
+
+    assert brain._maybe_detect_tail_loop(profiles) is not None
+
+
+def test_online_brain_suppresses_an_already_reported_loop() -> None:
+    brain = MatrixProfileBasedBrain(window_sizes=(3,), min_actions_before_loop=0)
+
+    for index, tool in enumerate(("search", "open", "edit") * 3):
+        brain.analyze(make_action(tool, index))
+
+    profiles = brain._update_current_profiles()
+
+    assert brain._maybe_detect_tail_loop(profiles) is None
+
+
+def test_macro_rejects_empty_action_patterns() -> None:
+    brain = MatrixProfileBasedBrain(window_sizes=(3,))
+    macro_events = []
+
+    for index in range(9):
+        if index % 3 == 1:
+            action = {
+                "tool": None,
+                "args": {},
+                "raw_action": "",
+                "thought": "",
+                "observation": "",
+                "execution_time": 0.0,
+            }
+        else:
+            action = make_action("open", index)
+        macro_events.extend(event for event in brain.analyze(action) if event["type"] == "macro_candidate")
+
+    assert macro_events == []
+
+
+def test_offline_brain_reemits_a_qualifying_macro() -> None:
+    brain = MatrixProfileBasedBrain(window_sizes=(3,), min_actions_before_loop=100, offline=True)
+
+    for index, tool in enumerate(("search", "edit", "bash-python") * 3):
+        brain.analyze(make_action(tool, index))
+
+    profiles = brain._update_current_profiles()
+
+    assert brain._maybe_suggest_macro(profiles) is not None
+
+
+def test_online_brain_suppresses_an_already_suggested_macro() -> None:
+    brain = MatrixProfileBasedBrain(window_sizes=(3,), min_actions_before_loop=100)
+
+    for index, tool in enumerate(("search", "edit", "bash-python") * 3):
+        brain.analyze(make_action(tool, index))
+
+    profiles = brain._update_current_profiles()
+
+    assert brain._maybe_suggest_macro(profiles) is None
+
+
+def test_loop_does_not_fire_before_minimum_action_count() -> None:
+    brain = MatrixProfileBasedBrain(window_sizes=(3,), min_actions_before_loop=15)
+    loop_steps = []
+
+    for index, tool in enumerate(("search", "open", "edit") * 5, start=1):
+        events = brain.analyze(make_action(tool, index))
+        loop_steps.extend(index for event in events if event["type"] == "loop_action")
+
+    assert loop_steps
+    assert min(loop_steps) >= 15
+
+
+def test_macro_rejects_pure_exploration_workflows() -> None:
+    brain = MatrixProfileBasedBrain(window_sizes=(3,))
+    macro_events = []
+
+    for index, tool in enumerate(("search_file", "open", "search_dir") * 3):
+        macro_events.extend(
+            event for event in brain.analyze(make_action(tool, index)) if event["type"] == "macro_candidate"
+        )
+
+    assert macro_events == []
+
+
+def test_macro_treats_python_versions_as_one_tool_family() -> None:
+    brain = MatrixProfileBasedBrain(window_sizes=(3,))
+
+    assert not brain._is_reusable_macro_pattern(("bash-python", "bash-python3", "bash-python3.11"))

+++ b/sweagent/agent/algorithm/utils/action_error.py
@@ -0,0 +1,262 @@
+from __future__ import annotations
+
+import re
+import shlex
+from typing import Any
+
+from sweagent.agent.algorithm.utils.lang_cpp import (
+    detect_observation_error_type as detect_observation_error_type_cpp,
+)
+from sweagent.agent.algorithm.utils.lang_cpp import (
+    is_validation_command as is_validation_command_cpp,
+)
+from sweagent.agent.algorithm.utils.lang_cpp import (
+    sanitize_non_compiler_error_tokens,
+)
+from sweagent.agent.algorithm.utils.lang_java import (
+    detect_observation_error_type as detect_observation_error_type_java,
+)
+from sweagent.agent.algorithm.utils.lang_java import (
+    is_validation_command as is_validation_command_java,
+)
+
+SYNTAX_ERRORS = {"SyntaxError", "IndentationError"}
+IMPORT_ERRORS = {"ImportError", "ModuleNotFoundError"}
+RUNTIME_ERRORS = {
+    "TypeError",
+    "AttributeError",
+    "RuntimeError",
+    "ValueError",
+    "KeyError",
+    "IndexError",
+    "NameError",
+    "FileNotFoundError",
+    "OSError",
+    "PermissionError",
+    "ZeroDivisionError",
+    "NotImplementedError",
+    "RecursionError",
+    "StopIteration",
+}
+PYTHON_COMMANDS = {
+    "python",
+    "python2",
+    "python3",
+    "python3.6",
+    "python3.7",
+    "python3.8",
+}
+ANSI_ESCAPE_PATTERN = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
+TIMEOUT_PATTERN = re.compile(
+    r"timed out|timeout|took more than \d+ seconds|was cancelled",
+    re.IGNORECASE,
+)
+PYTHON_NO_MODULE_PATTERN = re.compile(
+    r"^\s*\S*python(?:\d+(?:\.\d+)*)?:\s+No module named\s+\S+",
+    re.IGNORECASE | re.MULTILINE,
+)
+TRACEBACK_MARKER = "Traceback (most recent call last):"
+TRACEBACK_EXCEPTION_PATTERN = re.compile(r"^(?:[A-Za-z_]\w*\.)*[A-Z]\w*(?::.*)?$")
+
+
+def action_error_type(action: dict[str, Any], *, language: str = "python") -> str:
+    """Return the detected error type for a validation or patch action."""
+    if not action or not _is_validation_or_patch_action(action, language):
+        return "none"
+
+    observation = str(action.get("observation") or "")
+    if language == "python":
+        return _detect_observation_error_type(observation)
+    return detect_observation_error_type_for_language(observation, language)
+
+
+def detect_observation_error_type_for_language(observation: str, language: str) -> str:
+    """Try the java/cpp adapter first, then fall back to the shared detector."""
+    if language == "java":
+        result = detect_observation_error_type_java(observation)
+        if result != "none":
+            return result
+    elif language == "cpp":
+        result = detect_observation_error_type_cpp(observation)
+        if result == "pass":
+            # Authoritative clean run: skip the shared detector so its generic
+            # "FAILED"/"error:" rules cannot misfire on verbose success output.
+            return "none"
+        if result != "none":
+            return result
+        # The shared detector's bare-`error:` rule exists for python tracebacks;
+        # neutralize the non-compiler occurrences before falling back.
+        observation = sanitize_non_compiler_error_tokens(observation)
+    return _detect_observation_error_type(observation)
+
+
+def action_has_error(action: dict[str, Any]) -> bool:
+    """Return whether a validation or patch action produced an error."""
+    return action_error_type(action) != "none"
+
+
+def observation_error_fingerprint(observation: str, error_type: str) -> str | None:
+    """Return a normalized triggering line for an already detected error type."""
+    if error_type == "test_failure":
+        return "test_failure"
+    if error_type not in {"syntax", "import", "runtime"} or not observation:
+        return None
+
+    lines = observation.splitlines()
+    if error_type == "syntax":
+        return _last_normalized_line_containing(lines, SYNTAX_ERRORS)
+    if error_type == "import":
+        fingerprint = _last_normalized_line_containing(lines, IMPORT_ERRORS)
+        if fingerprint is not None:
+            return fingerprint
+        return next(
+            (_normalize_error_line(line) for line in lines if PYTHON_NO_MODULE_PATTERN.search(line)),
+            None,
+        )
+
+    timeout_line = next((line for line in lines if TIMEOUT_PATTERN.search(line)), None)
+    if timeout_line is not None:
+        return _normalize_error_line(timeout_line)
+
+    traceback_start = max(
+        (index for index, line in enumerate(lines) if TRACEBACK_MARKER in line),
+        default=-1,
+    )
+    if traceback_start >= 0:
+        for line in reversed(lines[traceback_start + 1 :]):
+            normalized = _normalize_error_line(line)
+            if TRACEBACK_EXCEPTION_PATTERN.fullmatch(normalized):
+                return normalized
+        return None
+
+    return _last_normalized_line_containing(lines, RUNTIME_ERRORS)
+
+
+def _last_normalized_line_containing(lines: list[str], markers: set[str]) -> str | None:
+    for line in reversed(lines):
+        if any(marker in line for marker in markers):
+            return _normalize_error_line(line)
+    return None
+
+
+def _normalize_error_line(line: str) -> str:
+    without_ansi = ANSI_ESCAPE_PATTERN.sub("", line)
+    return " ".join(without_ansi.split())
+
+
+def _is_validation_or_patch_action(action: dict[str, Any], language: str = "python") -> bool:
+    tool = str(action.get("tool") or "")
+    args = action.get("args")
+
+    if tool == "str_replace_editor":
+        command = str(args.get("command", "")) if isinstance(args, dict) else ""
+        return command in {"create", "str_replace", "insert"}
+
+    if tool in {"edit", "create"}:
+        return True
+
+    if not tool.startswith("bash-"):
+        return False
+
+    command = str(args or "").strip()
+    command_name = tool.removeprefix("bash-")
+
+    if language == "java" and is_validation_command_java(command):
+        return True
+    if language == "cpp" and is_validation_command_cpp(str(action.get("raw_action") or command)):
+        return True
+
+    if command_name in PYTHON_COMMANDS:
+        return _is_python_validation(command)
+
+    if command_name == "pytest":
+        return True
+
+    if command_name in {"sed", "awk"}:
+        if command_name == "sed" and re.search(r"-n\s+'?\d", command):
+            return False
+        return True
+
+    command_lower = command.lower()
+    if re.search(r"(>>|>\s)", command) and any(token in command_lower for token in ("cat ", "echo ", "printf ")):
+        return True
+
+    if command.startswith("./"):
+        return True
+
+    try:
+        first_token = shlex.split(command)[0]
+    except (ValueError, IndexError):
+        first_token = command.split()[0] if command.split() else ""
+    return first_token.startswith(("DJANGO_SETTINGS", "PYTHONPATH"))
+
+
+def _is_python_validation(command: str) -> bool:
+    if re.search(r"--help\b|-h\b", command) or "--version" in command:
+        return False
+
+    body = _extract_python_c_body(command)
+    if body:
+        lower = body.lower()
+        if any(keyword in lower for keyword in ("version", "__version__", "sys.version")):
+            return False
+
+        has_code_definition = bool(re.search(r"^\s*(?:class|(?:async\s+)?def)\s+\w+", body, re.MULTILINE))
+        if (
+            re.match(r"^[\"']?\s*import\s+\w", body)
+            and "assert" not in lower
+            and "test" not in lower
+            and not has_code_definition
+        ):
+            return False
+
+    return True
+
+
+def _extract_python_c_body(command: str) -> str:
+    try:
+        parts = shlex.split(command)
+    except ValueError:
+        parts = command.split()
+
+    for index, part in enumerate(parts):
+        if part == "-c" and index + 1 < len(parts):
+            return parts[index + 1]
+    return ""
+
+
+def _detect_observation_error_type(observation: str) -> str:
+    if not observation:
+        return "none"
+
+    if TIMEOUT_PATTERN.search(observation):
+        return "runtime"
+
+    if any(error in observation for error in SYNTAX_ERRORS):
+        return "syntax"
+
+    if any(error in observation for error in IMPORT_ERRORS):
+        return "import"
+
+    if PYTHON_NO_MODULE_PATTERN.search(observation):
+        return "import"
+
+    if "FAILED" in observation or "AssertionError" in observation:
+        return "test_failure"
+
+    if re.search(r"[1-9]\d* failed", observation):
+        return "test_failure"
+
+    if TRACEBACK_MARKER in observation:
+        return "runtime"
+
+    for line in observation.splitlines():
+        if re.search(r"\bexpected\b", line, re.IGNORECASE):
+            continue
+        if re.search(r"\berror:", line, re.IGNORECASE):
+            return "runtime"
+
+    if any(error in observation for error in RUNTIME_ERRORS):
+        return "runtime"
+
+    return "none"
diff --git a/sweagent/agent/algorithm/utils/action_semantic.py b/sweagent/agent/algorithm/utils/action_semantic.py
new file mode 100644
index 0000000..c0e8656
--- /dev/null
+++ b/sweagent/agent/algorithm/utils/action_semantic.py
@@ -0,0 +1,399 @@
+from __future__ import annotations
+
+import posixpath
+import re
+import shlex
+from typing import Any
+
+from sweagent.agent.algorithm.utils.action_error import action_error_type
+from sweagent.agent.algorithm.utils.lang_cpp import (
+    classify_bash_command as classify_bash_command_cpp,
+)
+from sweagent.agent.algorithm.utils.lang_cpp import (
+    extract_patch_target as extract_patch_target_cpp,
+)
+from sweagent.agent.algorithm.utils.lang_java import classify_bash_command as classify_bash_command_java
+
+ENV_COMMANDS = {
+    "pip",
+    "apt-get",
+    "apt",
+    "conda",
+    "make",
+    "export",
+    "source",
+    "sphinx-build",
+    "sphinx-quickstart",
+    "tox",
+    "cython",
+    "cythonize",
+}
+PYTHON_COMMANDS = {
+    "python",
+    "python2",
+    "python3",
+    "python3.6",
+    "python3.7",
+    "python3.8",
+}
+VR_PATTERN = re.compile(r"reproduce_|repro_|test_repro|bug_|debug_", re.IGNORECASE)
+_EDITED_FILES: set[str] = set()
+_READ_FILES: set[str] = set()
+READ_FILE_LABELS = {"Lt", "Lb"}
+PATCH_LABELS = {"P", "Ps", "Pi", "Pr"}
+
+SEMANTIC_LABEL_DISPLAY = {
+    "Emp": "empty action",
+    "Ls": "search",
+    "Lt": "targeted read",
+    "Lb": "browse whole file",
+    "P": "edit",
+    "Ps": "edit with syntax error",
+    "Pi": "edit with import error",
+    "Pr": "re-edit file",
+    "Vp": "test run with no error",
+    "Vf": "test run with failure",
+    "Ve": "test run with error",
+    "E": "environment setup",
+    "G": "general / other",
+}
+
+
+def action_semantic_label(
+    action: dict[str, Any],
+    *,
+    record_edit: bool = True,
+    language: str = "python",
+) -> str:
+    """Return the enriched semantic label for one parsed action."""
+    if not action:
+        return "SKIP"
+    raw_action = action.get("raw_action")
+    if isinstance(raw_action, str) and not raw_action.strip():
+        return "Emp"
+
+    base_phase, action_type = _classify_action(action, language)
+    error_type = _action_error_type(action, language)
+    target_file = _target_file(action, language)
+    is_repatch = base_phase == "P" and target_file is not None and target_file in _EDITED_FILES
+    if record_edit and base_phase == "P" and target_file:
+        _EDITED_FILES.add(target_file)
+    return _enrich_label(base_phase, action_type, error_type, is_repatch)
+
+
+def reset_action_semantic_state() -> None:
+    """Clear task-local state used to detect repeated patches."""
+    _EDITED_FILES.clear()
+    _READ_FILES.clear()
+
+
+def _is_create_action(action: dict[str, Any]) -> bool:
+    tool = str(action.get("tool") or "")
+    if tool == "create":
+        return True
+
+    args = action.get("args")
+    return tool == "str_replace_editor" and isinstance(args, dict) and args.get("command") == "create"
+
+
+def record_read_file(action: dict[str, Any], semantic_label: str) -> None:
+    """Record completed file reads and explicit file creations."""
+    if semantic_label not in READ_FILE_LABELS and not _is_create_action(action):
+        return
+
+    path = _target_file(action)
+    if path:
+        _READ_FILES.add(_normalize_path(path))
+
+
+def is_blind_patch_action(action: dict[str, Any], semantic_label: str) -> bool:
+    """Return whether a non-create patch targets a file not previously known."""
+    if semantic_label not in PATCH_LABELS or _is_create_action(action):
+        return False
+
+    path = _target_file(action)
+    if not path:
+        return False
+
+    return not _has_read_file(path)
+
+
+def action_target_file(action: dict[str, Any]) -> str | None:
+    return _target_file(action)
+
+
+def semantic_pattern_display(pattern: tuple[str, ...]) -> list[str]:
+    """Return human-readable text for each semantic label in a pattern."""
+    return [SEMANTIC_LABEL_DISPLAY.get(label, label) for label in pattern]
+
+
+def _normalize_path(path: str) -> str:
+    return posixpath.normpath(path)
+
+
+def _has_read_file(path: str) -> bool:
+    target = _normalize_path(path)
+    return any(_paths_match(read_path, target) for read_path in _READ_FILES)
+
+
+def _paths_match(read_path: str, target_path: str) -> bool:
+    if read_path == target_path:
+        return True
+    if not target_path.startswith("/"):
+        return read_path.endswith("/" + target_path) or read_path == target_path
+    return False
+
+
+def _action_error_type(action: dict[str, Any], language: str = "python") -> str:
+    observation = str(action.get("observation") or "")
+    filtered_action = dict(action)
+    filtered_action["observation"] = "\n".join(
+        re.sub(r"\berror:", "error :", line, flags=re.IGNORECASE)
+        if re.search(r"\bexpected\b", line, re.IGNORECASE)
+        else line
+        for line in observation.splitlines()
+    )
+    error_type = action_error_type(filtered_action, language=language)
+
+    if re.search(r"timed out|timeout|took more than \d+ seconds|was cancelled", observation, re.IGNORECASE):
+        return error_type
+    if error_type in {"syntax", "import"}:
+        return error_type
+    if re.search(
+        r"(?im)^\s*\S*python(?:\d+(?:\.\d+)*)?:\s+No module named\s+\S+",
+        observation,
+    ):
+        return "import"
+    return error_type
+
+
+def _classify_action(action: dict[str, Any], language: str = "python") -> tuple[str, str]:
+    tool = str(action.get("tool") or "")
+    args = action.get("args")
+
+    if not tool:
+        return ("SKIP", "empty")
+
+    if tool == "str_replace_editor":
+        command = str(args.get("command", "view")) if isinstance(args, dict) else "view"
+        has_view_range = bool(args.get("view_range")) if isinstance(args, dict) else False
+        return _classify_editor(command, has_view_range)
+
+    if tool == "open":
+        return ("L", "read_file")
+    if tool == "goto":
+        return ("L", "read_targeted")
+    if tool in {"scroll_down", "scroll_up"}:
+        return ("L", "navigate_file")
+    if tool == "edit":
+        return ("P", "edit")
+    if tool == "create":
+        return ("P", "create")
+    if tool == "search_file":
+        return ("L", "search_precise")
+    if tool in {"search_dir", "find_file"}:
+        return ("L", "search_broad")
+    if tool.startswith("bash-"):
+        return _classify_bash_command(
+            str(args or ""),
+            language,
+            raw_action=str(action.get("raw_action") or ""),
+        )
+
+    return ("G", "other")
+
+
+def _target_file(action: dict[str, Any], language: str = "python") -> str | None:
+    args = action.get("args")
+    if isinstance(args, dict):
+        path = args.get("path")
+        return str(path) if path else None
+    if language == "cpp":
+        return extract_patch_target_cpp(str(action.get("raw_action") or ""))
+    return None
+
+
+def _classify_editor(command: str, has_view_range: bool) -> tuple[str, str]:
+    if command == "view":
+        return ("L", "read_targeted" if has_view_range else "read_file")
+    if command == "create":
+        return ("P", "create")
+    if command in {"str_replace", "insert", "undo_edit"}:
+        return ("P", "edit")
+    return ("L", "read_file")
+
+
+def _classify_bash_command(
+    command: str,
+    language: str = "python",
+    *,
+    raw_action: str = "",
+) -> tuple[str, str]:
+    command = command.strip()
+    if not command:
+        return ("G", "other")
+
+    command = _strip_timeout_wrapper(command)
+    if language == "java":
+        adapted = classify_bash_command_java(command)
+        if adapted is not None:
+            return adapted
+    elif language == "cpp":
+        adapted = classify_bash_command_cpp(raw_action or command)
+        if adapted is not None:
+            return adapted
+    first_word = command.split()[0] if command else ""
+    command_lower = command.lower()
+
+    if first_word in PYTHON_COMMANDS:
+        if re.search(r"--help\b|-h\b", command):
+            return ("G", "other")
+        if "--version" in command:
+            return ("E", "environment")
+
+        body = _extract_python_c_body(command)
+        if body:
+            body_lower = body.lower()
+            if any(keyword in body_lower for keyword in ("version", "__version__", "sys.version")):
+                return ("E", "environment")
+
+            has_code_definition = bool(re.search(r"^\s*(?:class|(?:async\s+)?def)\s+\w+", body, re.MULTILINE))
+            if (
+                re.match(r"^[\"']?\s*import\s+\w", body)
+                and "assert" not in body_lower
+                and "test" not in body_lower
+                and not has_code_definition
+            ):
+                return ("E", "environment")
+            if _is_inline_reproduction(body):
+                return ("V", "reproduce")
+
+        if "pytest" in command:
+            return ("V", "run_tests")
+        if VR_PATTERN.search(command):
+            return ("V", "reproduce")
+        return ("V", "run_code")
+
+    if first_word == "pytest":
+        return ("V", "run_tests")
+    if first_word in {"sed", "awk"}:
+        if first_word == "sed" and re.search(r"-n\s+'?\d", command):
+            return ("L", "read_targeted")
+        return ("P", "edit")
+    if re.search(r"(>>|>\s)", command) and any(token in command_lower for token in ("cat ", "echo ", "printf ")):
+        return ("P", "edit")
+    if first_word in {"grep", "rg"}:
+        return ("L", "search_precise")
+    if first_word == "find":
+        return ("L", "search_broad")
+    if first_word in {"head", "tail"}:
+        return ("L", "read_targeted")
+    if first_word in {"cat", "less", "ls"}:
+        return ("L", "read_file")
+    if first_word in ENV_COMMANDS:
+        return ("E", "environment")
+    if any(token in command_lower for token in ("pip ", "apt ", "conda ", "apt-get ")):
+        return ("E", "environment")
+    if first_word == "cd":
+        return ("SKIP", "navigate_dir")
+    if first_word in {"rm", "mkdir", "mv", "cp", "touch", "chmod", "ln"}:
+        return ("SKIP", "file_mgmt")
+    if first_word == "submit":
+        return ("G", "submit")
+    if first_word in {"exit_cost", "exit_format"}:
+        return ("G", "give_up")
+    if first_word.startswith(("DJANGO_SETTINGS", "PYTHONPATH", "./")):
+        return ("V", "run_code")
+    return ("G", "other")
+
+
+def _enrich_label(base_phase: str, action_type: str, error_type: str, is_repatch: bool) -> str:
+    if base_phase == "SKIP":
+        return "SKIP"
+    if base_phase == "L":
+        if action_type in {"search_precise", "search_broad"}:
+            return "Ls"
+        if action_type == "read_targeted":
+            return "Lt"
+        return "Lb"
+    if base_phase == "P":
+        if error_type == "syntax":
+            return "Ps"
+        if error_type == "import":
+            return "Pi"
+        if is_repatch:
+            return "Pr"
+        return "P"
+    if base_phase == "V":
+        if error_type == "test_failure":
+            return "Vf"
+        if error_type in {"syntax", "import", "runtime"}:
+            return "Ve"
+        return "Vp"
+    if base_phase == "E":
+        return "E"
+    return "G"
+
+
+def _strip_timeout_wrapper(command: str) -> str:
+    try:
+        parts = shlex.split(command)
+    except ValueError:
+        return command
+    if not parts or parts[0] != "timeout":
+        return command
+
+    index = 1
+    while index < len(parts):
+        token = parts[index]
+        if token == "--":
+            index += 1
+            break
+        if token.startswith("--signal=") or token.startswith("--kill-after="):
+            index += 1
+            continue
+        if token in {"-s", "--signal", "-k", "--kill-after"}:
+            index += 2
+            continue
+        if token.startswith("-"):
+            index += 1
+            continue
+        index += 1
+        break
+
+    if index >= len(parts):
+        return command
+    return " ".join(shlex.quote(part) for part in parts[index:])
+
+
+def _extract_python_c_body(command: str) -> str:
+    try:
+        parts = shlex.split(command)
+    except ValueError:
+        parts = command.split()
+
+    for index, part in enumerate(parts):
+        if part == "-c" and index + 1 < len(parts):
+            return parts[index + 1]
+    return ""
+
+
+def _is_inline_reproduction(body: str) -> bool:
+    body_lower = body.lower()
+    if not re.search(r"\bassert\b|print\s*\(", body_lower):
+        return False
+
+    return bool(
+        re.search(r"\b(repro(?:duce|duction)?|regression|minimal failing|minimal example)\b", body_lower)
+        or re.search(r"expected.{0,120}(actual|got|instead)", body_lower, re.DOTALL)
+        or re.search(
+            r"should(?:\s+\w+){0,8}\s+be.{0,120}(but\s+is|got|instead)",
+            body_lower,
+            re.DOTALL,
+        )
+        or re.search(
+            r"issue:.{0,160}(expected|actual|should|but\s+is|got|instead)",
+            body_lower,
+            re.DOTALL,
+        )
+    )
diff --git a/sweagent/agent/algorithm/utils/lang_cpp.py b/sweagent/agent/algorithm/utils/lang_cpp.py
new file mode 100644
index 0000000..9dc1d7b
--- /dev/null
+++ b/sweagent/agent/algorithm/utils/lang_cpp.py
@@ -0,0 +1,316 @@
+"""C++-specific adapters for the semantic action labeler.
+
+Only consulted when the task language is "cpp" (see action_semantic /
+action_error routing). Every function falls back to the shared python-era
+logic by returning ``None`` / ``"none"`` / ``False`` on anything it does not
+recognize, so generic commands (grep, find, cat, edits, ...) keep using the
+shared classifiers.
+"""
+
+from __future__ import annotations
+
+import re
+import shlex
+
+CPP_COMPILER_PATTERN = re.compile(
+    r"^(?:g\+\+|gcc|clang\+\+|clang|cc|c\+\+)(?:-\d+(?:\.\d+)*)?$"
+)
+CPP_VERSION_FLAG_PATTERN = re.compile(r"(?:^|\s)--version(?:\s|$)")
+CPP_BUILD_TOOLS = {"cmake", "cmake3", "ninja", "meson", "make", "gmake", "configure", "autoreconf"}
+CPP_TEST_RUNNERS = {"ctest"}
+CPP_TEST_GOAL_PATTERN = re.compile(r"(?:^|\s)(?:test|check)s?(?:\s|$|-)", re.IGNORECASE)
+CPP_REPRO_NAME_PATTERN = re.compile(r"repro(?:duce|duction)?s?(?:$|[_\d.])", re.IGNORECASE)
+
+# Basenames that the shared classifier already handles (reads, searches,
+# file management, python, ...). Absolute/relative-path tokens whose basename
+# is in this set are left to the shared logic instead of being treated as
+# compiled test binaries.
+SHARED_UTILITY_BASENAMES = {
+    "find", "grep", "rg", "ag", "cat", "head", "tail", "less", "more", "ls", "dir",
+    "sed", "awk", "echo", "printf", "wc", "sort", "uniq", "diff", "cmp", "git",
+    "rm", "mkdir", "mv", "cp", "touch", "chmod", "ln", "which", "whereis", "env",
+    "bash", "sh", "zsh", "xargs", "tee", "true", "false", "pwd", "export", "source",
+    "tar", "unzip", "gzip", "curl", "wget", "man", "col", "column", "tr", "cut",
+    "patch", "apply_patch", "submit", "cd", "pip", "pip3", "pytest", "timeout",
+    "file", "stat", "du", "df", "ps", "kill", "sleep", "date", "whoami",
+}
+SHARED_UTILITY_BASENAME_PATTERN = re.compile(r"^python\d*(?:\.\d+)?$")
+
+CPP_TEST_FAILURE_PATTERN = re.compile(
+    r"\[\s+FAILED\s+\]"
+    r"|[1-9]\d* failed"
+    r"|[1-9]\d* tests? failed"
+    r"|test cases?:[^\n]*[1-9]\d* failed",
+    re.IGNORECASE,
+)
+CPP_CRASH_PATTERN = re.compile(
+    r"Segmentation fault"
+    r"|core dumped"
+    r"|\bAborted\b"
+    r"|terminate called after throwing"
+    r"|Assertion [^\n]{0,200} failed"
+    r"|what\(\):"
+    r"|command not found",
+)
+# Compiler diagnostics always carry a position prefix (file:line[:col]: error:)
+# or an emitter prefix (fatal error:, collect2:, g++:). A bare `error:` token
+# also appears in ordinary program output ("error: SUCCESS: No error",
+# "type_error::create", "Error: Parameter conversion ...") and must not be
+# treated as a compile error.
+CPP_COMPILE_ERROR_PATTERN = re.compile(
+    r":\d+(?::\d+)?: error:"
+    r"|\bfatal error:"
+    r"|collect2: error:"
+    r"|(?:g\+\+|gcc|clang\+\+|clang|cc|c\+\+): error:"
+    r"|undefined reference to"
+    r"|ld returned \d+ exit status"
+    r"|compilation terminated"
+    r"|No such file or directory",
+    re.IGNORECASE,
+)
+CPP_TIMEOUT_PATTERN = re.compile(
+    r"timed out|timeout|took more than \d+ seconds|was cancelled",
+    re.IGNORECASE,
+)
+CPP_PASS_BANNER_PATTERN = re.compile(
+    r"All tests passed"
+    r"|\[\s+PASSED\s+\]"
+    r"|100% tests passed"
+    r"|\b\d+/\d+ tests? passed",
+    re.IGNORECASE,
+)
+_BARE_ERROR_TOKEN_PATTERN = re.compile(r"\berror:", re.IGNORECASE)
+_HEREDOC_START_PATTERN = re.compile(r"<<-?\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1")
+_SHELL_SEPARATOR_PATTERN = re.compile(r"&&|\|\||;|\n")
+_LEADING_CONTROL_PATTERN = re.compile(r"^(?:(?:do|then)\s+)+")
+_LEADING_CD_PATTERN = re.compile(r"^\s*cd\s+([^\s;&]+)\s*&&")
+_PYTHON_OPEN_WRITE_PATTERN = re.compile(
+    r"\bopen\(\s*['\"]([^'\"]+)['\"]\s*,\s*['\"](?:w|a|x|r\+)[^'\"]*['\"]"
+)
+_PYTHON_PATH_WRITE_PATTERN = re.compile(
+    r"\bPath\(\s*['\"]([^'\"]+)['\"]\s*\)\.(?:write_text|write_bytes)\s*\("
+)
+_CPP_PATCH_SUFFIXES = (".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx", ".inl", ".ipp")
+
+
+def _basename(first_word: str) -> str:
+    return first_word.rsplit("/", 1)[-1]
+
+
+def _is_shared_utility(basename: str) -> bool:
+    return basename in SHARED_UTILITY_BASENAMES or bool(SHARED_UTILITY_BASENAME_PATTERN.match(basename))
+
+
+def _classify_simple_command(command: str) -> tuple[str, str] | None:
+    first_word = command.split()[0] if command.split() else ""
+    if not first_word:
+        return None
+    basename = _basename(first_word)
+    is_path_token = "/" in first_word
+
+    if CPP_COMPILER_PATTERN.match(basename):
+        if CPP_VERSION_FLAG_PATTERN.search(command):
+            return ("E", "environment")
+        if CPP_REPRO_NAME_PATTERN.search(command):
+            return ("V", "reproduce")
+        return ("V", "run_code")
+
+    if basename in CPP_TEST_RUNNERS:
+        return ("V", "run_tests")
+
+    if basename in CPP_BUILD_TOOLS:
+        if basename in {"make", "gmake", "ninja"} and CPP_TEST_GOAL_PATTERN.search(command):
+            return ("V", "run_tests")
+        return ("E", "environment")
+
+    if basename in {"bash", "sh"}:
+        try:
+            parts = shlex.split(command)
+        except ValueError:
+            parts = command.split()
+        if len(parts) > 1:
+            script_basename = _basename(parts[1])
+            if CPP_REPRO_NAME_PATTERN.search(script_basename) or re.search(
+                r"(?:^|[_-])(?:test|tests|run_tests)(?:$|[_\d.-])",
+                script_basename,
+                re.IGNORECASE,
+            ):
+                return ("V", "reproduce")
+
+    # Compiled binaries: executed via an absolute/relative path (`/tmp/reproduce`,
+    # `build/test_x`, `./reproduce2`) or as a bare reproduce-style name.
+    looks_like_binary = (is_path_token or CPP_REPRO_NAME_PATTERN.search(basename)) and not _is_shared_utility(basename)
+    if looks_like_binary:
+        if CPP_REPRO_NAME_PATTERN.search(basename):
+            return ("V", "reproduce")
+        return ("V", "run_code")
+
+    return None
+
+
+def _without_heredoc_bodies(command: str) -> str:
+    """Return shell control lines while omitting heredoc payloads."""
+    result: list[str] = []
+    delimiter: str | None = None
+    for line in command.splitlines():
+        if delimiter is not None:
+            if line.strip() == delimiter:
+                delimiter = None
+            continue
+        result.append(line)
+        match = _HEREDOC_START_PATTERN.search(line)
+        if match:
+            delimiter = match.group(2)
+    return "\n".join(result)
+
+
+def _command_segments(command: str) -> list[str]:
+    control_text = _without_heredoc_bodies(command)
+    segments: list[str] = []
+    for piece in _SHELL_SEPARATOR_PATTERN.split(control_text):
+        segment = _LEADING_CONTROL_PATTERN.sub("", piece.strip())
+        if segment:
+            segments.append(segment)
+    return segments
+
+
+def _aggregate_classifications(classifications: list[tuple[str, str]]) -> tuple[str, str] | None:
+    for phase in ("V", "P", "L", "E"):
+        matching = [classification for classification in classifications if classification[0] == phase]
+        if not matching:
+            continue
+        if phase == "V":
+            if any(action_type == "run_tests" for _, action_type in matching):
+                return ("V", "run_tests")
+            if any(action_type == "reproduce" for _, action_type in matching):
+                return ("V", "reproduce")
+        if phase == "L":
+            if any(action_type in {"search_precise", "search_broad"} for _, action_type in matching):
+                return ("L", "search_precise")
+            if any(action_type == "read_targeted" for _, action_type in matching):
+                return ("L", "read_targeted")
+        return matching[0]
+    return None
+
+
+def _cpp_control_classification(command: str) -> tuple[str, str] | None:
+    classifications: list[tuple[str, str]] = []
+    for segment in _command_segments(command):
+        classification = _classify_simple_command(segment)
+        if classification is not None:
+            classifications.append(classification)
+            continue
+        first_word = segment.split()[0] if segment.split() else ""
+        if first_word == "sed" and re.search(r"(?:^|\s)-n(?:\s|$)", segment):
+            classifications.append(("L", "read_targeted"))
+    return _aggregate_classifications(classifications)
+
+
+def _working_directory(command: str) -> str | None:
+    match = _LEADING_CD_PATTERN.search(command)
+    if not match:
+        return None
+    return match.group(1).strip("'\"")
+
+
+def _normalize_patch_target(path: str, working_directory: str | None) -> str | None:
+    path = path.strip("'\"")
+    if path.startswith("/tmp/") or not path.endswith(_CPP_PATCH_SUFFIXES):
+        return None
+    if path.startswith("/") or not working_directory:
+        return path
+    return working_directory.rstrip("/") + "/" + path.lstrip("/")
+
+
+def extract_patch_target(command: str) -> str | None:
+    """Extract a C++ source target from shell/Python edits in a raw action."""
+    working_directory = _working_directory(command)
+    for pattern in (_PYTHON_OPEN_WRITE_PATTERN, _PYTHON_PATH_WRITE_PATTERN):
+        for match in pattern.finditer(command):
+            target = _normalize_patch_target(match.group(1), working_directory)
+            if target:
+                return target
+
+    for segment in _command_segments(command):
+        if not re.match(r"^sed\s+", segment) or not re.search(r"(?:^|\s)-i(?:\s|$)", segment):
+            continue
+        try:
+            parts = shlex.split(segment)
+        except ValueError:
+            parts = segment.split()
+        if len(parts) < 3:
+            continue
+        target = _normalize_patch_target(parts[-1], working_directory)
+        if target:
+            return target
+    return None
+
+
+def classify_bash_command(command: str) -> tuple[str, str] | None:
+    """Classify a C++ shell action, including compound raw actions."""
+    command = command.strip()
+    if not command:
+        return None
+
+    if extract_patch_target(command) is not None and re.search(r"\bpython\d*(?:\.\d+)?\b", command):
+        return ("P", "edit")
+
+    return _cpp_control_classification(command)
+
+
+def detect_observation_error_type(observation: str) -> str:
+    """Detect cpp-specific error markers; ``"none"`` falls back to shared logic.
+
+    ``"pass"`` is an authoritative clean result (test-framework success
+    banner): the caller must return "none" without consulting the shared
+    detector, whose generic ``FAILED``/``error:`` rules misfire on verbose
+    success output such as Catch2's ``FAILED - but was ok`` lines.
+    """
+    if not observation:
+        return "none"
+
+    if CPP_TEST_FAILURE_PATTERN.search(observation):
+        return "test_failure"
+    if CPP_CRASH_PATTERN.search(observation):
+        return "runtime"
+    if CPP_COMPILE_ERROR_PATTERN.search(observation):
+        return "syntax"
+    if CPP_TIMEOUT_PATTERN.search(observation):
+        return "runtime"
+    if CPP_PASS_BANNER_PATTERN.search(observation):
+        return "pass"
+    return "none"
+
+
+def sanitize_non_compiler_error_tokens(observation: str) -> str:
+    """Rewrite ``error:`` tokens that are not part of compiler diagnostics.
+
+    The shared detector treats any ``error:`` line as a runtime error (a
+    python-era rule). In cpp trajectories that rule misfires on ordinary
+    program prints such as ``error: SUCCESS: No error`` or ``Error: Parameter
+    conversion ...``; real compiler diagnostics keep their ``error:`` token
+    because they match :data:`CPP_COMPILE_ERROR_PATTERN` and are protected.
+    """
+    protected = [m.span() for m in CPP_COMPILE_ERROR_PATTERN.finditer(observation)]
+    pieces: list[str] = []
+    prev = 0
+    for match in _BARE_ERROR_TOKEN_PATTERN.finditer(observation):
+        start, end = match.span()
+        if any(p_start <= start and end <= p_end for p_start, p_end in protected):
+            continue
+        pieces.append(observation[prev:start])
+        pieces.append("error ·")
+        prev = end
+    pieces.append(observation[prev:])
+    return "".join(pieces)
+
+
+def is_validation_command(command: str) -> bool:
+    """Return whether a bash command is a cpp build/test/run worth error-checking."""
+    command = command.strip()
+    if not command:
+        return False
+    return any(
+        classification is not None and classification[0] in {"V", "E"}
+        for classification in (_classify_simple_command(segment) for segment in _command_segments(command))
+    )
diff --git a/sweagent/agent/algorithm/utils/lang_java.py b/sweagent/agent/algorithm/utils/lang_java.py
new file mode 100644
index 0000000..0bcc910
--- /dev/null
+++ b/sweagent/agent/algorithm/utils/lang_java.py
@@ -0,0 +1,107 @@
+"""Java-specific adapters for the semantic action labeler.
+
+Only consulted when the task language is "java" (see action_semantic /
+action_error routing). Every function falls back to the shared python-era
+logic by returning ``None`` / ``"none"`` / ``False`` on anything it does not
+recognize, so generic commands (grep, find, cat, edits, ...) keep using the
+shared classifiers.
+"""
+
+from __future__ import annotations
+
+import re
+
+JAVA_BUILD_TOOLS = {"mvn", "mvnd", "mvnw", "gradle", "gradlew"}
+JAVA_RUN_COMMANDS = {"java", "javac", "javap", "jshell", "jdb"}
+JAVA_PACK_COMMANDS = {"jar"}
+
+MAVEN_TEST_GOAL_PATTERN = re.compile(r"(?:^|\s)(?:test|verify|check)(?:\s|$)|-Dtest=", re.IGNORECASE)
+GRADLE_TEST_TASK_PATTERN = re.compile(r"(?:^|\s)(?:\S*:)?(?:test|check)(?:\s|$)|(?:^|\s)check\s", re.IGNORECASE)
+VERSION_FLAG_PATTERN = re.compile(r"(?:^|\s)-(?:-)?version(?:\s|$)")
+
+JAVA_COMPILE_ERROR_PATTERN = re.compile(
+    r"COMPILATION ERROR|Compilation failure|cannot find symbol"
+    r"|package [\w.]+ does not exist"
+    r"|\.java:\[\d+,\d+\] error"
+    r"|\.java:\d+: error",
+    re.IGNORECASE,
+)
+JAVA_TEST_FAILURE_PATTERN = re.compile(
+    r"Tests run:.*Failures:\s*[1-9]"
+    r"|Tests run:.*Errors:\s*[1-9]"
+    r"|Tests in error"
+    r"|There are test failures"
+    r"|> Task :[^ ]* FAILED"
+    r"|[1-9]\d* tests? (?:completed|failed)",
+    re.IGNORECASE,
+)
+JAVA_RUNTIME_ERROR_PATTERN = re.compile(
+    r"BUILD FAILURE|BUILD FAILED|Exception in thread|Caused by:"
+    r"|command not found"
+    r"|javac: invalid flag"
+    r"|javac: directory not found"
+    r"|error: no source files"
+    r"|\[FATAL\]"
+    r"|Some problems were encountered while processing the POMs"
+    r"|Non-resolvable"
+    r"|Unresolveable build extension"
+    r"|Could not find artifact",
+)
+
+
+def _basename(first_word: str) -> str:
+    return first_word.rsplit("/", 1)[-1]
+
+
+def classify_bash_command(command: str) -> tuple[str, str] | None:
+    """Classify a java-specific bash command; ``None`` if not java-specific."""
+    command = command.strip()
+    if not command:
+        return None
+
+    first_word = command.split()[0]
+    basename = _basename(first_word)
+
+    if basename in JAVA_BUILD_TOOLS:
+        if VERSION_FLAG_PATTERN.search(command):
+            return ("E", "environment")
+        if basename == "gradle" or basename == "gradlew":
+            if GRADLE_TEST_TASK_PATTERN.search(command):
+                return ("V", "run_tests")
+        elif MAVEN_TEST_GOAL_PATTERN.search(command):
+            return ("V", "run_tests")
+        return ("E", "environment")
+
+    if basename in JAVA_RUN_COMMANDS:
+        if VERSION_FLAG_PATTERN.search(command):
+            return ("E", "environment")
+        return ("V", "run_code")
+
+    if basename in JAVA_PACK_COMMANDS:
+        return ("E", "environment")
+
+    return None
+
+
+def detect_observation_error_type(observation: str) -> str:
+    """Detect java-specific error markers; ``"none"`` falls back to shared logic."""
+    if not observation:
+        return "none"
+
+    if JAVA_COMPILE_ERROR_PATTERN.search(observation):
+        return "syntax"
+    if JAVA_TEST_FAILURE_PATTERN.search(observation):
+        return "test_failure"
+    if JAVA_RUNTIME_ERROR_PATTERN.search(observation):
+        return "runtime"
+    return "none"
+
+
+def is_validation_command(command: str) -> bool:
+    """Return whether a bash command is a java build/test/run worth error-checking."""
+    command = command.strip()
+    if not command:
+        return False
+
+    basename = _basename(command.split()[0])
+    return basename in JAVA_BUILD_TOOLS | JAVA_RUN_COMMANDS | JAVA_PACK_COMMANDS
diff --git a/sweagent/agent/algorithm/utils/llm_client.py b/sweagent/agent/algorithm/utils/llm_client.py
new file mode 100644
index 0000000..e39e06b
--- /dev/null
+++ b/sweagent/agent/algorithm/utils/llm_client.py
@@ -0,0 +1,48 @@
+from __future__ import annotations
+
+import os
+
+from openai import OpenAI
+
+_DEFAULT_BASE_URL = "https://api.openai.com/v1"
+
+
+def chat_completion(prompt: str, *, system: str | None = None, timeout: float | None = None) -> str:
+    """Call an OpenAI-style chat completions endpoint and return the message text.
+
+    Configuration is read from environment variables. Raises ``RuntimeError`` when
+    required config is missing or the response is empty; propagates SDK errors otherwise.
+    """
+    api_key = os.environ.get("TOOLPULSE_LLM_API_KEY") or os.environ.get("OPENAI_API_KEY")
+    if not api_key:
+        raise RuntimeError("TOOLPULSE_LLM_API_KEY (or OPENAI_API_KEY) is not set")
+    base_url = (
+        os.environ.get("TOOLPULSE_LLM_BASE_URL")
+        or os.environ.get("OPENAI_BASE_URL")
+        or _DEFAULT_BASE_URL
+    )
+    model = os.environ.get("TOOLPULSE_LLM_MODEL")
+    if not model:
+        raise RuntimeError("TOOLPULSE_LLM_MODEL is not set")
+    if timeout is None:
+        timeout = float(os.environ.get("TOOLPULSE_LLM_TIMEOUT", "30"))
+
+    messages: list[dict[str, str]] = []
+    if system:
+        messages.append({"role": "system", "content": system})
+    messages.append({"role": "user", "content": prompt})
+
+    kwargs: dict[str, object] = {"model": model, "messages": messages, "timeout": timeout}
+    max_tokens = os.environ.get("TOOLPULSE_LLM_MAX_TOKENS")
+    if max_tokens:
+        kwargs["max_tokens"] = int(max_tokens)
+    temperature = os.environ.get("TOOLPULSE_LLM_TEMPERATURE")
+    if temperature:
+        kwargs["temperature"] = float(temperature)
+
+    client = OpenAI(base_url=base_url, api_key=api_key)
+    response = client.chat.completions.create(**kwargs)
+    content = response.choices[0].message.content
+    if not content:
+        raise RuntimeError("LLM returned an empty response")
+    return content
diff --git a/sweagent/agent/algorithm/utils/llm_hint_builder.py b/sweagent/agent/algorithm/utils/llm_hint_builder.py
new file mode 100644
index 0000000..b43b94f
--- /dev/null
+++ b/sweagent/agent/algorithm/utils/llm_hint_builder.py
@@ -0,0 +1,139 @@
+from __future__ import annotations
+
+import json
+import logging
+import os
+from typing import Any
+
+from sweagent.agent.algorithm.utils.llm_client import chat_completion
+
+logger = logging.getLogger(__name__)
+
+_TRAJECTORY_FIELD_LIMIT = 500
+
+
+class LLMHintBuilder:
+    """Render llm_coach hints by filling the master prompt template and calling an LLM."""
+
+    def __init__(self, hint_set: dict[str, Any], *, offline: bool) -> None:
+        self.hint_set = hint_set
+        self.offline = offline
+
+    def build(
+        self,
+        events: list[dict[str, Any]],
+        task_description: str,
+        recent_trajectory: list[dict[str, Any]],
+    ) -> list[str]:
+        hints: list[str] = []
+        events_map = self.hint_set.get("events", {}) or {}
+        for event in events:
+            entry = events_map.get(event.get("type"))
+            if entry is None:
+                continue
+            if self.offline:
+                if os.environ.get("TOOLPULSE_LLM_DUMP_PROMPT") == "1":
+                    self._render_and_maybe_dump(event, entry, task_description, recent_trajectory)
+                hints.append(f"[llm-hint stub:{event.get('type')}]")
+                continue
+            try:
+                prompt = self._render_and_maybe_dump(event, entry, task_description, recent_trajectory)
+                text = chat_completion(prompt, system=self.hint_set.get("system_prompt"))
+            except Exception as exc:  # noqa: BLE001 - fail-soft: drop this event's hint
+                logger.warning("llm hint failed for %s: %s", event.get("type"), exc)
+                continue
+            text = text.strip()
+            if not text:
+                continue
+            hints.append(text)
+        return hints
+
+    def _render_and_maybe_dump(
+        self,
+        event: dict[str, Any],
+        entry: dict[str, Any],
+        task_description: str,
+        recent_trajectory: list[dict[str, Any]],
+    ) -> str:
+        prompt = self._render_prompt(event, entry, task_description, recent_trajectory)
+        if os.environ.get("TOOLPULSE_LLM_DUMP_PROMPT") == "1":
+            logger.info("llm hint prompt for %s:\n%s", event.get("type"), prompt)
+        return prompt
+
+    def _render_prompt(
+        self,
+        event: dict[str, Any],
+        entry: dict[str, Any],
+        task_description: str,
+        recent_trajectory: list[dict[str, Any]],
+    ) -> str:
+        template: str = self.hint_set.get("master_template", "")
+        # Phase 1: insert behavior/coaching (their text still contains leaf tokens).
+        prompt = template.replace("{{BEHAVIOR_DESCRIPTION}}", entry.get("behavior_description", ""))
+        prompt = prompt.replace("{{COACHING_POLICY}}", entry.get("coaching_policy", ""))
+        # Phase 2: fill master scalar tokens.
+        prompt = prompt.replace("{{TASK_DESCRIPTION}}", task_description or "")
+        prompt = prompt.replace("{{RECENT_TRAJECTORY}}", self._serialize_trajectory(recent_trajectory))
+        prompt = prompt.replace("{{METADATA}}", self._serialize_metadata(event, entry.get("metadata_fields")))
+        # Phase 2b: fill leaf tokens from the event.
+        for token, value in self._leaf_values(event).items():
+            prompt = prompt.replace("{{" + token + "}}", value)
+        return prompt
+
+    @staticmethod
+    def _leaf_values(event: dict[str, Any]) -> dict[str, str]:
+        etype = event.get("type")
+        values: dict[str, str] = {}
+        if etype == "duplicate_action":
+            current = event.get("current") or {}
+            values["TOOL"] = str(current.get("tool"))
+        elif etype == "failed_action":
+            values["ERROR_TYPE"] = str(event.get("error_type"))
+            values["TOOL"] = str(event.get("tool"))
+        elif etype == "blind_action":
+            values["PATH"] = str(event.get("path"))
+            values["TOOL"] = str(event.get("tool"))
+        elif etype == "loop_action":
+            values["PATTERN"] = str(event.get("pattern"))
+            values["REPEAT_TIMES"] = str(event.get("repeat_times"))
+        elif etype == "stalled_action":
+            values["SIZE"] = str(event.get("production"))
+        return values
+
+    def _serialize_trajectory(self, recent_trajectory: list[dict[str, Any]]) -> str:
+        if not recent_trajectory:
+            return "(no prior tool-use steps before the current action.)"
+        count = len(recent_trajectory)
+        noun = "step" if count == 1 else "steps"
+        blocks: list[str] = [
+            f"The {count} tool-use {noun} immediately before the current action (oldest to newest):"
+        ]
+        for index, action in enumerate(recent_trajectory):
+            # index 0 is the oldest shown -> farthest back; the last one immediately precedes the current action.
+            offset = count - index
+            if offset == 1:
+                label = "1 step before current (immediately preceding step)"
+            else:
+                label = f"{offset} steps before current"
+            blocks.append(
+                f"[{label}]\n"
+                f"ACTION: {action.get('raw_action', '')}\n"
+                f"THOUGHT: {action.get('thought', '')}\n"
+                f"OBSERVATION: {self._truncate(action.get('observation', ''))}"
+            )
+        return "\n\n".join(blocks)
+
+    def _serialize_metadata(self, event: dict[str, Any], metadata_fields: Any) -> str:
+        if metadata_fields:
+            subset = {key: event[key] for key in metadata_fields if key in event}
+        else:
+            subset = dict(event)
+        if "observation" in subset:
+            # Bound the top-level observation; nested values (e.g. duplicate's current) are left as-is.
+            subset["observation"] = self._truncate(subset["observation"])
+        return json.dumps(subset, ensure_ascii=False, default=str)
+
+    @staticmethod
+    def _truncate(text: Any, limit: int = _TRAJECTORY_FIELD_LIMIT) -> str:
+        text = str(text or "")
+        return text if len(text) <= limit else text[:limit] + "...<truncated>"
diff --git a/sweagent/agent/toolpulse.py b/sweagent/agent/toolpulse.py
new file mode 100644
index 0000000..feed043
--- /dev/null
+++ b/sweagent/agent/toolpulse.py
@@ -0,0 +1,212 @@
+from __future__ import annotations
+
+import json
+import shlex
+from typing import Any
+
+from sweagent.agent.algorithm.matrix_profile import MatrixProfileBasedBrain
+from sweagent.agent.algorithm.multi_granularity import MultiGranularityBrain
+from sweagent.agent.algorithm.sequitur_rule_based import SequiturRuleBasedBrain
+from sweagent.agent.algorithm.sequitur_semantic_based import SequiturSemanticBasedBrain
+from sweagent.agent.toolpulse_hints import DEFAULT_HINT_SET, ToolPulseHintRenderer
+from sweagent.agent.algorithm.utils.llm_hint_builder import LLMHintBuilder
+from sweagent.types import StepOutput
+
+TOOLPULSE_BRAIN = "multi_granularity"
+TOOLPULSE_HINT = DEFAULT_HINT_SET
+BRAIN_REGISTRY = {
+    "matrix_profile": MatrixProfileBasedBrain,
+    "multi_granularity": MultiGranularityBrain,
+    "sequitur_rule_based": SequiturRuleBasedBrain,
+    "sequitur_semantic_based": SequiturSemanticBasedBrain,
+}
+
+
+def _second_token(parts: list[str]) -> str | None:
+    return parts[1] if len(parts) > 1 else None
+
+
+def _strip_timeout_wrapper(cmd: str) -> str:
+    try:
+        parts = shlex.split(cmd)
+    except ValueError:
+        return cmd
+    if not parts or parts[0] != "timeout":
+        return cmd
+
+    i = 1
+    while i < len(parts):
+        token = parts[i]
+        if token == "--":
+            i += 1
+            break
+        if token.startswith("--signal=") or token.startswith("--kill-after="):
+            i += 1
+            continue
+        if token in ("-s", "--signal", "-k", "--kill-after"):
+            i += 2
+            continue
+        if token.startswith("-"):
+            i += 1
+            continue
+
+        i += 1
+        break
+
+    if i >= len(parts):
+        return cmd
+    return " ".join(shlex.quote(part) for part in parts[i:])
+
+
+def parse_action(action: str, state: Any = None) -> tuple[str | None, Any]:
+    action_for_parsing = action.strip()
+    if not action_for_parsing:
+        return None, {}
+
+    if action_for_parsing.startswith("cd ") and "&&" in action_for_parsing:
+        action_for_parsing = action_for_parsing.split("&&")[-1].strip()
+        if not action_for_parsing:
+            return "cd", {}
+
+    parts = action_for_parsing.split()
+    first_word = parts[0] if parts else ""
+
+    if action_for_parsing.startswith("str_replace_editor"):
+        return "str_replace_editor", {
+            "command": parts[1] if len(parts) >= 2 else "view",
+            "path": parts[2] if len(parts) > 2 else None,
+            "view_range": "--view_range" in action_for_parsing,
+        }
+
+    if first_word == "open":
+        return "open", {"path": _second_token(parts)}
+
+    if first_word == "goto":
+        return "goto", {}
+
+    if first_word in ("scroll_down", "scroll_up"):
+        return first_word, {}
+
+    if first_word == "edit":
+        target = None
+        if state:
+            try:
+                state_dict = json.loads(state) if isinstance(state, str) else state
+                target = state_dict.get("open_file")
+            except (json.JSONDecodeError, TypeError, AttributeError):
+                target = None
+        return "edit", {"path": target}
+
+    if first_word == "create":
+        return "create", {"path": _second_token(parts)}
+
+    if first_word == "search_file":
+        return "search_file", {}
+
+    if first_word in ("search_dir", "find_file"):
+        return first_word, {}
+
+    command = _strip_timeout_wrapper(action_for_parsing)
+    command_parts = command.split()
+    command_first_word = command_parts[0] if command_parts else action_for_parsing
+    return f"bash-{command_first_word}", command
+
+
+class ToolPulse:
+    """Track action patterns within one task and produce lightweight hints."""
+
+    def __init__(
+        self,
+        brain_name: str = TOOLPULSE_BRAIN,
+        hint_set_name: str = TOOLPULSE_HINT,
+        *,
+        offline: bool = False,
+        language: str = "python",
+    ) -> None:
+        self.brain_name = brain_name
+        self.hint_set_name = hint_set_name
+        self.offline = offline
+        self.language = language
+        self.hint_renderer = ToolPulseHintRenderer()
+        self.task_description: str = ""
+        self._llm_builder: LLMHintBuilder | None = None
+        self.reset()
+
+    def reset(self) -> None:
+        self.brain = self._build_brain(self.brain_name, offline=self.offline, language=self.language)
+
+    def set_task_description(self, description: str | None) -> None:
+        """Set the task description used by the llm_coach hint set."""
+        self.task_description = description or ""
+
+    def observe_action(self, step: StepOutput) -> None:
+        """Inspect a proposed action before environment execution."""
+        events = self.brain.inspect(self._action_from_step(step))
+        self._store_hints(step, events, self._recent_steps(drop_last=False))
+
+    def observe_step(self, step: StepOutput) -> None:
+        """Record a completed step and store a hint when a rule fires."""
+        if step.done:
+            return
+
+        events = self.brain.analyze(self._action_from_step(step))
+        self._store_hints(step, events, self._recent_steps(drop_last=True))
+
+    def _recent_steps(self, *, drop_last: bool) -> list[dict[str, Any]]:
+        actions = self.brain.actions
+        if drop_last and actions:
+            actions = actions[:-1]
+        return actions[-3:]
+
+    @staticmethod
+    def _action_from_step(step: StepOutput) -> dict[str, Any]:
+        raw_action = step.action.strip()
+        tool, args = parse_action(raw_action, step.state)
+        return {
+            "tool": tool,
+            "args": args,
+            "raw_action": raw_action,
+            "observation": step.observation,
+            "thought": step.thought or "",
+            "execution_time": step.execution_time or 0.0,
+        }
+
+    def _store_hints(
+        self, step: StepOutput, events: list[dict[str, Any]], recent_trajectory: list[dict[str, Any]]
+    ) -> None:
+        observation = step.observation or ""
+        for event in events:
+            # Let the llm_coach builder expose the triggering step's observation in METADATA.
+            event.setdefault("observation", observation)
+        hints = self._build_hints(events, recent_trajectory)
+        if not hints:
+            return
+
+        hint = "\n".join(f"- {item}" for item in hints)
+        step.extra_info["toolpulse_hint"] = hint
+
+    @staticmethod
+    def _build_brain(brain_name: str, *, offline: bool = False, language: str = "python") -> Any:
+        try:
+            brain_cls = BRAIN_REGISTRY[brain_name]
+        except KeyError as exc:
+            known = ", ".join(sorted(BRAIN_REGISTRY))
+            message = f"Unknown ToolPulse brain {brain_name!r}. Known brains: {known}"
+            raise ValueError(message) from exc
+        return brain_cls(offline=offline, language=language)
+
+    def _build_hints(
+        self, events: list[dict[str, Any]], recent_trajectory: list[dict[str, Any]]
+    ) -> list[str]:
+        hint_set = self.hint_renderer.hint_sets.get(self.hint_set_name, {})
+        if hint_set.get("type") == "llm":
+            return self._llm_hint_builder().build(events, self.task_description, recent_trajectory)
+        return self.hint_renderer.render(events, self.hint_set_name)
+
+    def _llm_hint_builder(self) -> LLMHintBuilder:
+        if self._llm_builder is None:
+            self._llm_builder = LLMHintBuilder(
+                self.hint_renderer.hint_sets[self.hint_set_name],
+                offline=self.offline,
+            )
+        return self._llm_builder

+    monkeypatch.setattr(
+        llm_hint_builder,
+        "chat_completion",
+        lambda p, *, system=None: captured.setdefault("p", p) or "ok",
+    )
+    builder = LLMHintBuilder(_hint_set(master="{{RECENT_TRAJECTORY}}"), offline=False)
+    builder.build([{"type": "blind_action", "tool": "edit", "path": "a.py"}], "t", [])
+    assert "no prior tool-use steps before the current action" in captured["p"]

+def test_cpp_reproduce_named_binary_is_reproduce() -> None:
+    assert _label("cd /nlohmann__json && ./reproduce2", language="cpp") == "Vp"
+
+
+def test_cpp_build_tools_are_environment() -> None:
+    assert _label("cd /fmtlib__fmt && cmake -S . -B build", language="cpp") == "E"
+    assert _label("make -j4", language="cpp") == "E"
+
+
+def test_cpp_make_test_and_ctest_are_validation() -> None:
+    assert _label("make test", language="cpp") == "Vp"
+    assert _label("ctest --output-on-failure", language="cpp") == "Vp"
+
+
+def test_cpp_test_framework_failure_is_vf() -> None:
+    obs = (
+        "================================================================\n"
+        "test cases:  5 | 3 passed | 2 failed\n"
+        "assertions: 12 | 10 passed | 2 failed\n"
+    )
+    assert _label("/tmp/json_unit", obs, language="cpp") == "Vf"
+
+
+def test_cpp_googletest_failed_marker_is_vf() -> None:
+    assert _label("./test_dom_ptr", "[  FAILED  ] 2 tests", language="cpp") == "Vf"

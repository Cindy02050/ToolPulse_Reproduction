+"""Language adapters for the semantic action labeler (java / cpp).
+
+Observation snippets below are condensed from real trajectories in
+model_output/baselines/sweagent/sweagent_outputs/deepseek-v4-pro/{java,cpp}.
+The python cases at the bottom double as regression guards: with the default
+language the labels must stay exactly as before the adapters existed.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from sweagent.agent.algorithm.utils.action_semantic import (
+    action_semantic_label,
+    reset_action_semantic_state,
+)
+from sweagent.agent.toolpulse import parse_action
+
+
+def _label(raw_action: str, observation: str = "", language: str = "python") -> str:
+    tool, args = parse_action(raw_action)
+    action: dict[str, Any] = {
+        "tool": tool,
+        "args": args,
+        "raw_action": raw_action,
+        "observation": observation,
+    }
+    return action_semantic_label(action, language=language)
+
+
+@pytest.fixture(autouse=True)
+def _clean_state():
+    reset_action_semantic_state()
+    yield
+    reset_action_semantic_state()
+
+
+# ---------------------------------------------------------------------------
+# Java: command classification
+# ---------------------------------------------------------------------------
+
+def test_java_mvn_test_is_validation() -> None:
+    assert _label("mvn test -pl gson -am -Dtest=RecursiveTypesResolveTest", language="java") == "Vp"
+
+
+def test_java_mvn_test_with_failures_is_vf() -> None:
+    obs = (
+        "Tests in error:\n"
+        "  testRecursiveTypeVariablesResolve12(com.google.gson.internal.bind.RecursiveTypesResolveTest)\n"
+        "Tests run: 4, Failures: 1, Errors: 3, Skipped: 0\n"
+        "[ERROR] BUILD FAILURE\n"
+    )
+    assert _label("cd /google__gson && mvn test -pl gson -am", obs, language="java") == "Vf"
+
+
+def test_java_mvn_compilation_error_is_ve() -> None:
+    obs = (
+        "[ERROR] COMPILATION ERROR :\n"
+        "[ERROR] /gson/src/main/java/com/google/gson/Gson.java:[123,45] error: cannot find symbol\n"
+    )
+    assert _label("mvn test -pl gson", obs, language="java") == "Ve"
+
+
+def test_java_mvn_build_only_is_environment() -> None:
+    assert _label("mvn clean install -DskipTests", language="java") == "E"
+
+
+def test_java_gradlew_test_is_validation_build_is_environment() -> None:
+    assert _label("cd /repo && ./gradlew test", language="java") == "Vp"
+    assert _label("cd /repo && ./gradlew build", language="java") == "E"
+
+
+def test_java_version_flags_are_environment() -> None:
+    assert _label("java -version", language="java") == "E"
+    assert _label("mvn --version", language="java") == "E"
+
+
+def test_java_run_and_compile_are_validation() -> None:
+    assert _label("javac -cp . Foo.java", language="java") == "Vp"
+    assert _label("java -cp . Foo", language="java") == "Vp"
+
+
+def test_java_uncaught_exception_is_ve() -> None:
+    obs = 'Exception in thread "main" java.lang.NullPointerException\n\tat Foo.main(Foo.java:5)\n'
+    assert _label("java -cp . Foo", obs, language="java") == "Ve"
+
+
+def test_java_generic_commands_fall_back_to_shared_logic() -> None:
+    assert _label('grep -rn "parse" src/', language="java") == "Ls"
+    assert _label("find / -name JsonPointer.java -type f", language="java") == "Ls"
+    assert _label("sed -n '5,10p' build.gradle", language="java") == "Lt"
+    assert _label("cat settings.gradle", language="java") == "Lb"
+    assert _label("python3 check.py", language="java") == "Vp"
+
+
+def test_java_edits_unchanged_by_adapter() -> None:
+    assert _label("str_replace_editor str_replace /repo/src/Foo.java old new", language="java") == "P"
+    assert _label("str_replace_editor str_replace /repo/src/Foo.java old new", language="java") == "Pr"
+
+
+# ---------------------------------------------------------------------------
+# Java: error detection edge cases
+# ---------------------------------------------------------------------------
+
+def test_java_gradle_failed_task_is_vf() -> None:
+    obs = "> Task :gson:test FAILED\n\nFAILURE: Build failed with an exception.\n"
+    assert _label("./gradlew test", obs, language="java") == "Vf"
+
+
+def test_java_successful_build_has_no_error() -> None:
+    obs = "[INFO] BUILD SUCCESS\n[INFO] Tests run: 12, Failures: 0, Errors: 0, Skipped: 0\n"
+    assert _label("mvn test", obs, language="java") == "Vp"
+
+
+def test_java_timeout_falls_back_to_shared_detector() -> None:

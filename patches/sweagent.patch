+from __future__ import annotations
+
+from collections import Counter
+from typing import Any
+
+from sksequitur import Grammar, Parser, Production
+
+from sweagent.agent.algorithm.utils.action_error import action_error_type
+from sweagent.agent.algorithm.utils.action_semantic import (
+    action_semantic_label,
+    reset_action_semantic_state,
+    semantic_pattern_display,
+)
+
+Pattern = tuple[str, ...]
+EMPTY_ACTION_TOOL = "<empty_action>"
+
+
+class SequiturSemanticBasedBrain:
+    """Detect repeated semantic action patterns with Sequitur."""
+
+    def __init__(
+        self,
+        min_pattern_len: int = 3,
+        repeat_times_for_loop: int = 3,
+        min_count_for_pattern: int = 2,
+        min_count_for_semantic_macro: int = 4,
+        min_count_for_tool_macro: int = 3,
+        min_prefix_len_for_hint: int = 2,
+        offline: bool = False,
+        language: str = "python",
+    ) -> None:
+        self.min_pattern_len = min_pattern_len
+        self.repeat_times_for_loop = repeat_times_for_loop
+        self.min_count_for_pattern = min_count_for_pattern
+        self.min_count_for_semantic_macro = min_count_for_semantic_macro
+        self.min_count_for_tool_macro = min_count_for_tool_macro
+        self.min_prefix_len_for_hint = min_prefix_len_for_hint
+        self.offline = offline
+        self.language = language
+        self.reset()
+
+    def reset(self) -> None:
+        reset_action_semantic_state()
+        self.parser = Parser()
+        self.actions: list[dict[str, Any]] = []
+        self.tools: list[str] = []
+        self.semantic_labels: list[str] = []
+        self.pattern_counts: Counter[Pattern] = Counter()
+        self.custom_tool_suggested: set[Pattern] = set()
+        self.repeated_production_reported: set[Pattern] = set()
+
+    def inspect(self, action: dict[str, Any]) -> list[dict[str, Any]]:
+        """Inspect a proposed action without updating detector state."""
+        return []
+
+    def analyze(self, action: dict[str, Any]) -> list[dict[str, Any]]:
+        """Analyze one parsed action and return structured events."""
+        if not action:
+            return []
+
+        tool = action.get("tool")
+        raw_action = action.get("raw_action")
+        semantic_label = action_semantic_label(action, language=self.language)
+        if semantic_label == "SKIP":
+            return []
+        if semantic_label == "Emp":
+            action = {
+                **action,
+                "tool": EMPTY_ACTION_TOOL,
+                "args": {},
+                "raw_action": "",
+            }
+            tool = EMPTY_ACTION_TOOL
+        elif not tool or not raw_action:
+            return []
+
+        events: list[dict[str, Any]] = []
+
+        duplicate_event = self._check_exact_duplicate_action(action, semantic_label)
+        if duplicate_event:
+            events.append(duplicate_event)
+
+        error_type = action_error_type(action, language=self.language)
+        if error_type != "none":
+            events.append(
+                {
+                    "type": "failed_action",
+                    "error_type": error_type,
+                    "tool": tool,
+                }
+            )
+
+        self.actions.append(action)
+        self.tools.append(tool)
+        self.semantic_labels.append(semantic_label)
+        self.parser.feed([semantic_label])
+
+        grammar = Grammar(self.parser.tree)
+
+        loop_event = self._check_tail_repeated_production(grammar)
+        if loop_event:
+            events.append(loop_event)
+
+        patterns = self._extract_patterns(grammar)
+        self._update_pattern_counts(patterns)
+
+        # next_tool_prediction is intentionally disabled for now. It tended to
+        # reinforce historical tool-use inertia instead of helping the agent
+        # break out of inefficient loops.
+        # prediction_event = self._predict_next_tool()
+        # if prediction_event:
+        #     events.append(prediction_event)
+
+        custom_tool_event = self._maybe_suggest_custom_tool()
+        if custom_tool_event:
+            events.append(custom_tool_event)
+
+        return events
+
+    def snapshot(self) -> dict[str, Any]:
+        return {
+            "actions": self.actions,
+            "tools": self.tools,
+            "semantic_labels": self.semantic_labels,
+            "pattern_counts": {" -> ".join(pattern): count for pattern, count in self.pattern_counts.items()},
+        }
+
+    def current_grammar(self) -> Grammar:
+        return Grammar(self.parser.tree)
+
+    def _check_exact_duplicate_action(
+        self,
+        current: dict[str, Any],
+        current_semantic_label: str,
+    ) -> dict[str, Any] | None:
+        if not self.actions:
+            return None
+
+        previous = self.actions[-1]
+        previous_semantic_label = self.semantic_labels[-1]
+        if previous_semantic_label == current_semantic_label and previous.get("raw_action") == current.get(
+            "raw_action"
+        ):
+            return {
+                "type": "duplicate_action",
+                "current": current,
+                "previous": previous,
+            }
+
+        return None
+
+    def _check_tail_repeated_production(self, grammar: Grammar) -> dict[str, Any] | None:
+        start_body = grammar[Production(0)]
+
+        if len(start_body) < self.repeat_times_for_loop:
+            return None
+
+        tail = start_body[-self.repeat_times_for_loop :]
+
+        if not all(isinstance(item, Production) for item in tail):
+            return None
+
+        if len(set(tail)) != 1:
+            return None
+
+        repeated_prod = tail[0]
+        pattern = tuple(grammar.expand(repeated_prod))
+
+        if len(pattern) < self.min_pattern_len:
+            return None
+
+        if not self.offline and pattern in self.repeated_production_reported:
+            return None
+        if not self.offline:
+            self.repeated_production_reported.add(pattern)
+
+        return {
+            "type": "loop_action",
+            "production": str(repeated_prod),
+            "repeat_times": self.repeat_times_for_loop,
+            "pattern": semantic_pattern_display(pattern),
+        }
+
+    def _extract_patterns(self, grammar: Grammar) -> dict[Pattern, int]:
+        patterns: dict[Pattern, int] = {}
+        counts = grammar.counts()
+
+        for production in grammar:
+            if production == Production(0):
+                continue
+
+            expansion = tuple(grammar.expand(production))
+
+            if len(expansion) < self.min_pattern_len:
+                continue
+
+            if counts[production] < self.min_count_for_pattern:
+                continue
+
+            if self._is_single_label_repetition(expansion):
+                continue
+
+            patterns[expansion] = max(patterns.get(expansion, 0), counts[production])
+
+        return patterns
+
+    def _update_pattern_counts(self, patterns: dict[Pattern, int]) -> None:
+        for pattern, count in patterns.items():
+            self.pattern_counts[pattern] = max(self.pattern_counts[pattern], count)
+
+    def _predict_next_tool(self) -> dict[str, Any] | None:
+        if not self.pattern_counts:
+            return None
+
+        best: tuple[int, Pattern, str] | None = None
+
+        for pattern, score in self.pattern_counts.items():
+            if len(pattern) <= self.min_prefix_len_for_hint:
+                continue
+
+            max_prefix_len = len(pattern) - 1
+            for prefix_len in range(max_prefix_len, self.min_prefix_len_for_hint - 1, -1):
+                prefix = pattern[:prefix_len]
+
+                if len(self.semantic_labels) < prefix_len:
+                    continue
+
+                suffix = tuple(self.semantic_labels[-prefix_len:])
+                if suffix != prefix:
+                    continue
+
+                next_tool = pattern[prefix_len]
+                candidate = (score * prefix_len, pattern, next_tool)
+                if best is None or candidate[0] > best[0]:
+                    best = candidate
+                break
+
+        if best is None:
+            return None
+
+        score, pattern, next_tool = best
+        return {
+            "type": "next_tool_prediction",
+            "pattern": list(pattern),
+            "next_tool": next_tool,
+            "score": score,
+        }
+
+    def _maybe_suggest_custom_tool(self) -> dict[str, Any] | None:
+        for semantic_pattern, semantic_count in self.pattern_counts.most_common():
+            if semantic_count < self.min_count_for_semantic_macro:
+                continue
+
+            tool_patterns = self._matching_tool_patterns(semantic_pattern)
+            for tool_pattern, tool_count in tool_patterns.most_common():
+                if tool_count < self.min_count_for_tool_macro:
+                    continue
+
+                if len(set(tool_pattern)) == 1:
+                    continue
+
+                if not self.offline and tool_pattern in self.custom_tool_suggested:
+                    continue
+
+                if not self.offline:
+                    self.custom_tool_suggested.add(tool_pattern)
+
+                return {
+                    "type": "macro_candidate",
+                    "pattern": list(tool_pattern),
+                    "count": tool_count,
+                    "suggested_name": "custom_" + "_".join(tool_pattern[:4]),
+                }
+
+        return None
+
+    def _matching_tool_patterns(self, semantic_pattern: Pattern) -> Counter[Pattern]:
+        tool_patterns: Counter[Pattern] = Counter()
+        pattern_len = len(semantic_pattern)
+
+        for start in range(len(self.semantic_labels) - pattern_len + 1):
+            end = start + pattern_len
+            if tuple(self.semantic_labels[start:end]) != semantic_pattern:
+                continue
+
+            tool_patterns[tuple(self.tools[start:end])] += 1
+
+        return tool_patterns
+
+    @staticmethod
+    def _is_single_label_repetition(pattern: Pattern) -> bool:
+        return len(set(pattern)) == 1

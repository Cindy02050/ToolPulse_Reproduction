+def test_step_observation_is_stamped_into_metadata_and_truncated(monkeypatch) -> None:
+    import sweagent.agent.algorithm.utils.llm_hint_builder as builder_mod
+
+    captured: dict = {}
+
+    def _capture(prompt, *, system=None):
+        captured["prompt"] = prompt
+        return "ok"
+
+    monkeypatch.setattr(builder_mod, "chat_completion", _capture)
+    monitor = ToolPulse(brain_name="multi_granularity", hint_set_name="llm_coach", offline=False)
+    monitor.brain.analyze = MagicMock(return_value=[{"type": "blind_action", "tool": "edit", "path": "a.py"}])
+    long_observation = "Z" * 700
+    step = StepOutput(action="edit a.py", observation=long_observation)
+    monitor.observe_step(step)
+    prompt = captured["prompt"]
+    # Include the current step observation in METADATA, truncated to 500 characters.
+    assert "Z" * 500 + "...<truncated>" in prompt
+    assert "Z" * 700 not in prompt
+    assert step.extra_info["toolpulse_hint"] == "- ok"

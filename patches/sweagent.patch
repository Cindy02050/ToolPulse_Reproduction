+from __future__ import annotations
+
+import json
+import sys
+from collections.abc import Iterator
+from importlib.machinery import SourceFileLoader
+from importlib.util import module_from_spec, spec_from_loader
+from pathlib import Path
+from types import ModuleType
+from unittest.mock import MagicMock
+
+import pytest
+
+from sweagent.agent.algorithm.sequitur_semantic_based import SequiturSemanticBasedBrain
+from sweagent.agent.models import InstantEmptySubmitModelConfig
+from sweagent.agent.toolpulse import TOOLPULSE_BRAIN, TOOLPULSE_HINT
+from sweagent.types import StepOutput
+
+SWE_AGENT_ROOT = Path(__file__).resolve().parents[1]
+AGENT_MODULE_PATHS = (
+    SWE_AGENT_ROOT / "sweagent/agent/agents.py",
+    SWE_AGENT_ROOT / "sweagent/agent/agents_apptainer.py",
+)
+
+
+@pytest.fixture(params=AGENT_MODULE_PATHS, ids=lambda path: path.name)
+def agent_module(request: pytest.FixtureRequest) -> Iterator[ModuleType]:
+    path = request.param
+    module_name = f"sweagent.agent._brain_config_test_{path.name.replace('.', '_')}"
+    loader = SourceFileLoader(module_name, str(path))
+    spec = spec_from_loader(module_name, loader)
+    assert spec is not None
+    module = module_from_spec(spec)
+    sys.modules[module_name] = module
+    try:
+        loader.exec_module(module)
+        yield module
+    finally:
+        sys.modules.pop(module_name, None)
+
+
+def make_default_agent(agent_module: ModuleType):
+    config = agent_module.DefaultAgentConfig(model=InstantEmptySubmitModelConfig())
+    return agent_module.DefaultAgent.from_config(config)
+
+
+def prepare_step_wrapper(agent, step: StepOutput) -> None:
+    agent._env = MagicMock()
+    agent._chook = MagicMock()
+    agent.forward_with_handling = MagicMock(return_value=step)
+    agent.add_step_to_history = MagicMock()
+    agent.add_step_to_trajectory = MagicMock()
+    agent._get_edited_files_with_context = MagicMock(return_value={})
+    agent.info = {}
+
+
+def test_default_agent_config_uses_toolpulse_defaults(agent_module: ModuleType) -> None:
+    config = agent_module.DefaultAgentConfig(model=InstantEmptySubmitModelConfig())
+
+    assert config.brain == TOOLPULSE_BRAIN
+    assert config.hint == TOOLPULSE_HINT
+
+
+def test_default_agent_uses_configured_brain_and_hint(agent_module: ModuleType) -> None:
+    config = agent_module.DefaultAgentConfig.model_validate(
+        {

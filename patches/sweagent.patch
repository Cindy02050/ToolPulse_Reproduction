+
+def test_cpp_generic_commands_fall_back_to_shared_logic() -> None:
+    assert _label('grep -rn "value_type" src/', language="cpp") == "Ls"
+    assert _label("find / -name catch.hpp", language="cpp") == "Ls"
+    assert _label("python3 /tmp/check.py", language="cpp") == "Vp"
+
+
+def test_cpp_shared_utilities_via_absolute_path_not_mistaken_for_binary() -> None:
+    # /usr/bin/grep must not be treated as a compiled test binary; the adapter
+    # declines it and the outcome matches python mode's treatment ("G").
+    assert _label('/usr/bin/grep -rn "fmt" include/', language="cpp") == "G"
+
+
+def test_cpp_edits_unchanged_by_adapter() -> None:
+    assert _label("str_replace_editor insert /repo/src/json.hpp 10 new_line", language="cpp") == "P"
+
+
+# ---------------------------------------------------------------------------
+# Python regression: default language must be unaffected by the adapters
+# ---------------------------------------------------------------------------
+
+def test_python_default_language_unchanged() -> None:
+    obs = (
+        "Traceback (most recent call last):\n"
+        '  File "/testbed/x.py", line 1, in <module>\n'
+        "ModuleNotFoundError: No module named 'some_missing_module'\n"
+    )
+    assert _label("python3 /testbed/x.py", obs) == "Ve"
+    assert _label("python -c \"import some_missing_module\"") == "E"
+    assert _label("pytest tests/", "1 failed, 3 passed in 0.5s") == "Vf"
+    assert _label("sed -n '5,10p' file.py") == "Lt"
+    assert _label("python3 /testbed/reproduce.py") == "Vp"
+
+
+def test_python_mode_ignores_java_cpp_commands() -> None:
+    # mvn/g++ are "G" for python tasks, exactly as before the adapters existed.
+    assert _label("mvn test -pl gson") == "G"
+    assert _label("g++ -o /tmp/r r.cpp") == "G"
+    assert _label("/tmp/json_unit") == "G"
+
+
+# ---------------------------------------------------------------------------
+# Regression cases distilled from the full-trajectory manual review
+# ---------------------------------------------------------------------------
+
+def test_cpp_compiler_version_is_environment() -> None:
+    assert _label("g++ --version", language="cpp") == "E"

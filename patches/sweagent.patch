+def _hint_set(master: str = "{{TASK_DESCRIPTION}}|{{RECENT_TRAJECTORY}}|{{BEHAVIOR_DESCRIPTION}}|{{METADATA}}|{{COACHING_POLICY}}") -> dict:
+    return {
+        "type": "llm",
+        "master_template": master,
+        "events": {
+            "blind_action": {
+                "behavior_description": "edit {{PATH}} via {{TOOL}}",
+                "coaching_policy": "inspect first {not a token}",
+                "metadata_fields": ["tool", "path"],
+            },
+            "duplicate_action": {
+                "behavior_description": "dup {{TOOL}}",
+                "coaching_policy": "policy-dup",
+                "metadata_fields": ["current"],
+            },
+            "loop_action": {
+                "behavior_description": "loop {{PATTERN}} x{{REPEAT_TIMES}}",
+                "coaching_policy": "policy-loop",
+            },
+            "stalled_action": {
+                "behavior_description": "stalled win={{SIZE}}",
+                "coaching_policy": "policy-stalled",
+            },
+            "failed_action": {
+                "behavior_description": "failed {{ERROR_TYPE}} from {{TOOL}}",
+                "coaching_policy": "policy-failed",
+            },
+        },
+    }
+
+
+def test_offline_returns_stub_without_calling_client(monkeypatch):
+    def _boom(*a, **k):
+        raise AssertionError("must not call client in offline mode")
+    monkeypatch.setattr(llm_hint_builder, "chat_completion", _boom)
+    builder = LLMHintBuilder(_hint_set(), offline=True)
+    out = builder.build([{"type": "blind_action", "tool": "edit", "path": "a.py"}], "task", [])
+    assert out == ["[llm-hint stub:blind_action]"]
+

+from __future__ import annotations
+
+import pytest
+
+from sweagent.agent.algorithm.utils import llm_client
+
+
+class _FakeMessage:
+    def __init__(self, content):
+        self.content = content
+
+
+class _FakeChoice:
+    def __init__(self, content):
+        self.message = _FakeMessage(content)
+
+
+class _FakeResponse:
+    def __init__(self, content):
+        self.choices = [_FakeChoice(content)]
+
+
+class _FakeCompletions:
+    def __init__(self, recorded, content, exc):
+        self._recorded = recorded
+        self._content = content
+        self._exc = exc
+
+    def create(self, **kwargs):
+        self._recorded.update(kwargs)
+        if self._exc is not None:
+            raise self._exc
+        return _FakeResponse(self._content)
+
+
+class _FakeChat:
+    def __init__(self, completions):
+        self.completions = completions
+
+
+class _FakeOpenAIFactory:
+    """Pretends to be the OpenAI class: callable as OpenAI(base_url=, api_key=)."""
+
+    def __init__(self, recorded, content, exc=None):
+        self._recorded = recorded
+        self._content = content
+        self._exc = exc
+
+    def __call__(self, *, base_url, api_key):
+        self._recorded["_base_url"] = base_url
+        self._recorded["_api_key"] = api_key
+        client = type("Client", (), {})()
+        client.chat = _FakeChat(_FakeCompletions(self._recorded, self._content, self._exc))
+        return client
+
+
+def test_returns_content_and_shapes_request(monkeypatch):
+    monkeypatch.setenv("TOOLPULSE_LLM_API_KEY", "key123")
+    monkeypatch.setenv("TOOLPULSE_LLM_BASE_URL", "https://example.test/v1")
+    monkeypatch.setenv("TOOLPULSE_LLM_MODEL", "mini")
+    recorded: dict = {}
+    monkeypatch.setattr(llm_client, "OpenAI", _FakeOpenAIFactory(recorded, content="hello world"))
+    out = llm_client.chat_completion("do the thing", system="be brief")
+    assert out == "hello world"
+    assert recorded["model"] == "mini"
+    assert recorded["messages"] == [
+        {"role": "system", "content": "be brief"},
+        {"role": "user", "content": "do the thing"},
+    ]
+    assert recorded["_base_url"] == "https://example.test/v1"
+    assert recorded["_api_key"] == "key123"
+
+
+def test_omits_system_message_when_none(monkeypatch):
+    monkeypatch.setenv("TOOLPULSE_LLM_API_KEY", "k")
+    monkeypatch.setenv("TOOLPULSE_LLM_MODEL", "m")
+    recorded: dict = {}
+    monkeypatch.setattr(llm_client, "OpenAI", _FakeOpenAIFactory(recorded, content="ok"))
+    llm_client.chat_completion("prompt")
+    assert recorded["messages"] == [{"role": "user", "content": "prompt"}]
+
+
+def test_raises_when_api_key_missing(monkeypatch):
+    monkeypatch.delenv("TOOLPULSE_LLM_API_KEY", raising=False)
+    monkeypatch.delenv("OPENAI_API_KEY", raising=False)
+    monkeypatch.setenv("TOOLPULSE_LLM_MODEL", "m")
+    with pytest.raises(RuntimeError, match="API_KEY"):
+        llm_client.chat_completion("prompt")
+
+
+def test_raises_when_model_missing(monkeypatch):
+    monkeypatch.setenv("TOOLPULSE_LLM_API_KEY", "k")
+    monkeypatch.delenv("TOOLPULSE_LLM_MODEL", raising=False)
+    with pytest.raises(RuntimeError, match="MODEL"):
+        llm_client.chat_completion("prompt")
+
+
+def test_raises_on_empty_response(monkeypatch):
+    monkeypatch.setenv("TOOLPULSE_LLM_API_KEY", "k")
+    monkeypatch.setenv("TOOLPULSE_LLM_MODEL", "m")
+    recorded: dict = {}

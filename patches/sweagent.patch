+def _spy_recent_trajectory(monkeypatch, captured):
+    import sweagent.agent.algorithm.utils.llm_hint_builder as builder_mod
+
+    original = builder_mod.LLMHintBuilder.build
+
+    def _spy(self, events, task_description, recent_trajectory):
+        captured["traj"] = [a["raw_action"] for a in recent_trajectory]
+        return original(self, events, task_description, recent_trajectory)
+
+    monkeypatch.setattr(builder_mod.LLMHintBuilder, "build", _spy)

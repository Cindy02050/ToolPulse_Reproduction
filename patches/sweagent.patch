+def test_live_renders_all_tokens_and_calls_client(monkeypatch):
+    captured: dict = {}
+
+    def _fake(prompt, *, system=None):
+        captured["prompt"] = prompt
+        captured["system"] = system
+        return "HINT"
+
+    monkeypatch.setattr(llm_hint_builder, "chat_completion", _fake)
+    builder = LLMHintBuilder(_hint_set(), offline=False)
+    event = {"type": "blind_action", "tool": "edit", "path": "a.py", "raw_action": "edit a.py"}

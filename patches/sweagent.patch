+from __future__ import annotations
+
+import pytest
+
+from sweagent.agent.algorithm.multi_granularity import MultiGranularityBrain
+from sweagent.agent.algorithm.utils.action_error import observation_error_fingerprint
+
+
+def make_action(tool: str, index: int) -> dict:
+    return {
+        "tool": tool,
+        "args": {"index": index},
+        "raw_action": f"{tool} {index}",
+        "observation": "",
+    }
+
+
+def make_validation(
+    observation: str,
+    *,
+    tool: str = "bash-python",
+    raw_action: str = "python check.py",
+) -> dict:
+    return {
+        "tool": tool,
+        "args": raw_action,
+        "raw_action": raw_action,
+        "observation": observation,
+    }
+
+
+def failed_events(brain: MultiGranularityBrain, action: dict) -> list[dict]:
+    return [event for event in brain.analyze(action) if event["type"] == "failed_action"]
+
+
+def test_error_fingerprint_normalizes_only_ansi_and_whitespace() -> None:
+    observation = "noise\n\x1b[31m  FileNotFoundError:  [Errno 2]  /tmp/data42.json  \x1b[0m"
+
+    assert observation_error_fingerprint(observation, "runtime") == ("FileNotFoundError: [Errno 2] /tmp/data42.json")
+
+
+def test_error_fingerprint_uses_last_syntax_and_import_key_lines() -> None:
+    assert (
+        observation_error_fingerprint(
+            "SyntaxError: old\n  SyntaxError: invalid decimal literal 42",
+            "syntax",
+        )
+        == "SyntaxError: invalid decimal literal 42"
+    )
+    assert (
+        observation_error_fingerprint(
+            "ImportError: old\nModuleNotFoundError: No module named 'pkg2'",
+            "import",
+        )
+        == "ModuleNotFoundError: No module named 'pkg2'"
+    )
+
+
+def test_error_fingerprint_uses_python_no_module_key_line() -> None:
+    observation = "setup\n/usr/bin/python3: No module named pytest"
+
+    assert observation_error_fingerprint(observation, "import") == "/usr/bin/python3: No module named pytest"
+
+
+def test_error_fingerprint_uses_final_exception_from_last_traceback() -> None:
+    observation = """Traceback (most recent call last):
+  File "a.py", line 1, in <module>
+ValueError: first 12
+
+During handling of the above exception, another exception occurred:
+
+Traceback (most recent call last):
+  File "a.py", line 4, in <module>
+NameError: name 'answer42' is not defined
+"""
+
+    assert observation_error_fingerprint(observation, "runtime") == ("NameError: name 'answer42' is not defined")
+
+
+def test_error_fingerprint_handles_timeout_and_fixed_test_failure() -> None:
+    assert observation_error_fingerprint("setup\nCommand took more than 30 seconds", "runtime") == (
+        "Command took more than 30 seconds"
+    )
+    assert observation_error_fingerprint("FAILED tests/test_a.py::test_one", "test_failure") == "test_failure"
+    assert observation_error_fingerprint("AssertionError: another failure", "test_failure") == "test_failure"
+
+
+def test_error_fingerprint_rejects_low_confidence_runtime_lines() -> None:
+    assert observation_error_fingerprint("compiler error: informational output", "runtime") is None
+    assert observation_error_fingerprint("Traceback (most recent call last):", "runtime") is None
+
+
+def test_failed_action_keeps_different_fingerprints_and_tools_separate() -> None:
+    brain = MultiGranularityBrain(failed_action_repeat_threshold=2)
+
+    assert failed_events(brain, make_validation("NameError: name 'left' is not defined")) == []
+    assert failed_events(brain, make_validation("NameError: name 'right' is not defined")) == []
+    assert (
+        failed_events(
+            brain,
+            make_validation(
+                "NameError: name 'left' is not defined",
+                tool="bash-python3",
+                raw_action="python3 check.py",
+            ),
+        )
+        == []
+    )
+    assert len(failed_events(brain, make_validation("NameError: name 'left' is not defined"))) == 1
+
+
+def test_failed_action_aggregates_test_failures_without_specific_fingerprint() -> None:
+    brain = MultiGranularityBrain(failed_action_repeat_threshold=2)
+
+    assert (
+        failed_events(
+            brain,
+            make_validation("FAILED tests/test_a.py::test_one", tool="bash-pytest", raw_action="pytest -q"),
+        )
+        == []
+    )
+    events = failed_events(
+        brain,
+        make_validation("AssertionError: different test", tool="bash-pytest", raw_action="pytest -q"),
+    )
+
+    assert events[0]["error_fingerprint"] == "test_failure"
+
+
+def test_failed_action_reads_and_searches_do_not_clear_cluster() -> None:
+    brain = MultiGranularityBrain(failed_action_repeat_threshold=2)
+    failure = make_validation("NameError: name 'value7' is not defined")
+
+    assert failed_events(brain, failure) == []
+    brain.analyze({"tool": "open", "args": {"path": "a.py"}, "raw_action": "open a.py", "observation": ""})
+    brain.analyze({"tool": "search_file", "args": {}, "raw_action": "search_file value7 a.py", "observation": ""})
+
+    assert len(failed_events(brain, failure)) == 1
+
+
+def test_failed_action_patch_and_environment_actions_clear_clusters() -> None:
+    failure = make_validation("NameError: name 'value7' is not defined")
+    recovery_actions = [
+        {"tool": "edit", "args": {"path": "a.py"}, "raw_action": "edit a.py", "observation": ""},
+        {
+            "tool": "edit",
+            "args": {"path": "a.py"},
+            "raw_action": "edit a.py",
+            "observation": "SyntaxError: invalid syntax",
+        },
+        {
+            "tool": "edit",
+            "args": {"path": "a.py"},
+            "raw_action": "edit a.py",
+            "observation": "ImportError: missing dependency",
+        },
+        {
+            "tool": "bash-pip",
+            "args": "pip install package",
+            "raw_action": "pip install package",
+            "observation": "installed",
+        },
+    ]
+
+    for recovery in recovery_actions:
+        brain = MultiGranularityBrain(failed_action_repeat_threshold=2)
+        assert failed_events(brain, failure) == []
+        brain.analyze(recovery)
+        assert failed_events(brain, failure) == []
+
+
+def test_failed_action_repatch_clears_cluster() -> None:
+    brain = MultiGranularityBrain(failed_action_repeat_threshold=2)
+    failure = make_validation("NameError: name 'x' is not defined")
+    edit = {"tool": "edit", "args": {"path": "a.py"}, "raw_action": "edit a.py", "observation": ""}
+
+    assert failed_events(brain, failure) == []
+    brain.analyze(edit)
+    assert failed_events(brain, failure) == []
+    brain.analyze(edit)
+    assert failed_events(brain, failure) == []
+
+
+def test_failed_patch_clears_old_clusters_before_starting_its_own() -> None:
+    brain = MultiGranularityBrain(failed_action_repeat_threshold=2)
+    validation_failure = make_validation("NameError: name 'x' is not defined")
+    failing_patch = {
+        "tool": "edit",
+        "args": {"path": "a.py"},
+        "raw_action": "edit a.py",
+        "observation": "SyntaxError: invalid syntax",
+    }
+
+    assert failed_events(brain, validation_failure) == []
+    assert failed_events(brain, failing_patch) == []
+    assert failed_events(brain, failing_patch) == []
+    assert failed_events(brain, validation_failure) == []
+
+
+def test_failed_action_success_clears_only_same_tool_clusters() -> None:
+    brain = MultiGranularityBrain(failed_action_repeat_threshold=2)
+    python_failure = make_validation("NameError: name 'x' is not defined")
+    pytest_failure = make_validation("FAILED tests/test_a.py::test_one", tool="bash-pytest", raw_action="pytest -q")
+
+    assert failed_events(brain, python_failure) == []
+    assert failed_events(brain, pytest_failure) == []
+    brain.analyze(make_validation("ok"))
+
+    assert failed_events(brain, python_failure) == []
+    assert len(failed_events(brain, pytest_failure)) == 1
+
+
+def test_failed_action_external_error_flag_prevents_success_clear() -> None:
+    brain = MultiGranularityBrain(failed_action_repeat_threshold=2)
+    failure = make_validation("NameError: name 'x' is not defined")
+    flagged_success = make_validation("ok")
+    flagged_success["has_error"] = True
+
+    assert failed_events(brain, failure) == []
+    brain.analyze(flagged_success)
+
+    assert len(failed_events(brain, failure)) == 1
+
+
+def test_failed_action_cluster_expires_outside_window() -> None:
+    brain = MultiGranularityBrain(failed_action_repeat_threshold=2, failed_action_window_steps=2)
+    failure = make_validation("NameError: name 'x' is not defined")
+
+    assert failed_events(brain, failure) == []
+    brain.analyze(make_action("open", 1))
+    brain.analyze(make_action("open", 2))
+    assert failed_events(brain, failure) == []
+    assert len(failed_events(brain, failure)) == 1
+
+
+def test_failed_action_skips_low_confidence_runtime_but_keeps_error_feature() -> None:
+    brain = MultiGranularityBrain(failed_action_repeat_threshold=2)
+    generic_error = make_validation("compiler error: informational output")
+    malformed_traceback = make_validation("Traceback (most recent call last):")
+
+    assert failed_events(brain, generic_error) == []
+    assert brain.raw_features[-1].has_error is True
+    assert failed_events(brain, generic_error) == []
+    assert failed_events(brain, malformed_traceback) == []
+    assert brain.raw_features[-1].has_error is True
+    assert failed_events(brain, malformed_traceback) == []
+
+
+def test_failed_action_state_resets_and_config_is_validated() -> None:
+    brain = MultiGranularityBrain(failed_action_repeat_threshold=2)
+    failure = make_validation("NameError: name 'x' is not defined")
+
+    assert failed_events(brain, failure) == []
+    brain.reset()
+    assert failed_events(brain, failure) == []
+
+    with pytest.raises(ValueError, match="failed_action_repeat_threshold"):
+        MultiGranularityBrain(failed_action_repeat_threshold=0)
+    with pytest.raises(ValueError, match="failed_action_window_steps"):
+        MultiGranularityBrain(failed_action_window_steps=0)
+
+
+def test_multi_granularity_does_not_emit_macro_candidates() -> None:
+    brain = MultiGranularityBrain()
+    event_types = []
+
+    for index, tool in enumerate(("search_file", "open", "edit") * 4):
+        event_types.extend(event["type"] for event in brain.analyze(make_action(tool, index)))
+
+    assert "macro_candidate" not in event_types
+
+
+def test_multi_granularity_duplicate_action_fires_on_third_consecutive_match() -> None:
+    brain = MultiGranularityBrain()
+    action = make_action("open", 0)
+
+    first_events = brain.analyze(action)
+    second_events = brain.analyze(action)
+    third_events = brain.analyze(action)
+
+    assert [event["type"] for event in first_events] == []
+    assert "duplicate_action" not in [event["type"] for event in second_events]
+    assert "duplicate_action" in [event["type"] for event in third_events]
+
+
+def test_multi_granularity_stalled_action_distinguishes_arguments() -> None:
+    brain = MultiGranularityBrain(
+        window_sizes=(3,),
+        min_actions_before_stalled=0,
+        stalled_distance_threshold=0.1,
+    )
+    actions = []
+    for name in "abc":
+        actions.extend(
+            [
+                {
+                    "tool": "search_file",
+                    "args": {"query": name, "path": f"{name}.py"},
+                    "raw_action": f"search_file {name} {name}.py",
+                    "observation": "ok",
+                },
+                {
+                    "tool": "open",
+                    "args": {"path": f"{name}.py"},
+                    "raw_action": f"open {name}.py",
+                    "observation": "ok",
+                },
+                {
+                    "tool": "bash-pytest",
+                    "args": f"pytest -q tests/test_{name}.py",
+                    "raw_action": f"pytest -q tests/test_{name}.py",
+                    "observation": "ok",
+                },
+            ]
+        )
+    events = []
+
+    for action in actions:
+        events.extend(brain.analyze(action))
+
+    assert "loop_action" in [event["type"] for event in events]
+    assert "stalled_action" not in [event["type"] for event in events]
+
+
+def test_multi_granularity_stalled_action_allows_repeated_single_tool_workflow() -> None:
+    brain = MultiGranularityBrain(window_sizes=(3,), min_actions_before_stalled=0)
+    action = {"tool": "open", "args": {"path": "a.py"}, "raw_action": "open a.py", "observation": "ok"}
+    events = []
+
+    for _ in range(9):
+        events.extend(brain.analyze(action))
+
+    assert "loop_action" not in [event["type"] for event in events]
+    stalled_events = [event for event in events if event["type"] == "stalled_action"]
+    assert len(stalled_events) == 1
+    assert stalled_events[0]["pattern"] == ["open", "open", "open"]
+    assert stalled_events[0]["score"] == 0.0
+
+
+@pytest.mark.parametrize(
+    "action",
+    [
+        {
+            "tool": "create",
+            "args": {"path": "a.py"},
+            "raw_action": "create a.py",
+            "observation": "",
+        },
+        {
+            "tool": "str_replace_editor",
+            "args": {"command": "create", "path": "a.py"},
+            "raw_action": "str_replace_editor create a.py",
+            "observation": "",
+        },
+    ],
+)
+def test_multi_granularity_blind_action_exempts_explicit_create(action: dict) -> None:
+    brain = MultiGranularityBrain()
+
+    events = brain.inspect(action)
+
+    assert "blind_action" not in [event["type"] for event in events]
+
+
+@pytest.mark.parametrize(
+    ("create_action", "modify_action"),
+    [
+        (
+            {
+                "tool": "create",
+                "args": {"path": "a.py"},

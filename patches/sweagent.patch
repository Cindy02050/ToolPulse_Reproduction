+
+    brain.analyze(create_action)
+    events = brain.inspect(modify_action)
+
+    assert "blind_action" not in [event["type"] for event in events]
+
+
+@pytest.mark.parametrize("command", ["str_replace", "insert"])
+def test_multi_granularity_blind_action_still_fires_for_unread_editor_modification(command: str) -> None:
+    brain = MultiGranularityBrain()
+    action = {
+        "tool": "str_replace_editor",
+        "args": {"command": command, "path": "a.py"},
+        "raw_action": f"str_replace_editor {command} a.py",
+        "observation": "",
+    }
+
+    events = brain.inspect(action)
+
+    assert "blind_action" in [event["type"] for event in events]
+
+
+def test_multi_granularity_blind_action_fires_when_editing_unread_file() -> None:
+    brain = MultiGranularityBrain()
+
+    events = brain.inspect(
+        {
+            "tool": "edit",
+            "args": {"path": "a.py"},
+            "raw_action": "edit a.py",
+            "observation": "",
+        }
+    )
+
+    assert {
+        "type": "blind_action",
+        "tool": "edit",
+        "path": "a.py",
+        "raw_action": "edit a.py",
+    } in events

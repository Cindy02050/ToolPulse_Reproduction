+
+
+# ---------------------------------------------------------------------------
+# C++: command classification
+# ---------------------------------------------------------------------------
+
+def test_cpp_compiler_is_validation() -> None:
+    assert _label("g++ -std=c++11 -I. -o /tmp/r /tmp/r.cpp src/json.cc", language="cpp") == "Vp"
+    assert _label("clang++-14 -o test main.cpp", language="cpp") == "Vp"
+
+
+def test_cpp_compile_error_is_ve() -> None:
+    obs = (
+        "src/simdjson.cpp:3:10: fatal error: base.h: No such file or directory\n"
+        "    3 | #include <base.h>\n"
+        "compilation terminated.\n"
+    )
+    assert _label("g++ -std=c++11 -o /tmp/reproduce /tmp/reproduce.cpp", obs, language="cpp") == "Ve"
+
+
+def test_cpp_absolute_path_binary_is_validation_not_general() -> None:
+    assert _label("/tmp/json_unit", language="cpp") == "Vp"
+    assert _label("/tmp/reproduce_existing", language="cpp") == "Vp"

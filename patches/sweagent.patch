+        "Document 0:\n"
+        "  error: SUCCESS: No error\n"
+        "  source: '[1,2,3]'\n"
+        "Total documents: 2\n"
+    )
+    assert _label("/tmp/reproduce2", obs, language="cpp") == "Vp"

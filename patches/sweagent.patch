+++ b/sweagent/agent/algorithm/matrix_profile.py
@@ -0,0 +1,797 @@
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import re
+import shlex
+from collections import Counter
+from dataclasses import dataclass
+from typing import Any
+
+import numpy as np
+
+from sweagent.agent.algorithm.utils.action_error import action_error_type
+
+Pattern = tuple[str, ...]
+EMPTY_ACTION_TOOL = "<empty_action>"
+
+
+def stable_hash_int(text: str, algorithm: str) -> int:
+    encoded = text.encode("utf-8")
+    if algorithm == "md5":
+        return int(hashlib.md5(encoded).hexdigest(), 16)
+    if algorithm == "blake2b":
+        return int(hashlib.blake2b(encoded, digest_size=8).hexdigest(), 16)
+    if algorithm == "sha256":
+        return int(hashlib.sha256(encoded).hexdigest(), 16)
+    message = f"Unknown hash algorithm: {algorithm}"
+    raise ValueError(message)
+
+
+def triple_hash_vector(text: str, dim: int = 16) -> np.ndarray:
+    """Map text to three distinct dimensions and L2-normalize the block."""
+    vector = np.zeros(dim, dtype=float)
+    used: set[int] = set()
+
+    for algorithm in ("md5", "blake2b", "sha256"):
+        index = stable_hash_int(text, algorithm) % dim
+        while index in used:
+            index = (index + 1) % dim
+        used.add(index)
+        vector[index] = 1.0
+
+    return vector / (np.linalg.norm(vector) + 1e-8)
+
+
+@dataclass(frozen=True)
+class FeatureWeights:
+    thought: float = 0.25
+    tool: float = 0.80
+    args: float = 0.45
+    observation: float = 0.30
+    execution: float = 0.35
+    error: float = 0.70
+
+
+@dataclass(frozen=True)
+class RawStepFeatures:
+    thought_length: float
+    tool_hash: np.ndarray
+    args_hash: np.ndarray
+    observation_length: float
+    execution_time: float
+    has_error: bool
+
+
+class StepFeaturizer:
+    """Encode actions in one shared, causally fitted 36-dimensional space."""
+
+    n_dims = 36
+
+    def __init__(
+        self,
+        weights: FeatureWeights | None = None,
+        scalar_clip: float = 5.0,
+        scalar_eps: float = 1e-8,
+        scalar_warmup: int = 2,
+    ) -> None:
+        self.weights = weights or FeatureWeights()
+        self.scalar_clip = scalar_clip
+        self.scalar_eps = scalar_eps
+        self.scalar_warmup = scalar_warmup
+
+    def extract(self, action: dict[str, Any], *, has_error: bool) -> RawStepFeatures:
+        thought = str(action.get("thought") or "")
+        tool = str(action.get("tool") or "UNKNOWN")
+        args = action.get("args", {})
+        observation = str(action.get("observation") or "")
+        execution_time = float(action.get("execution_time") or 0.0)
+        serialized_args = json.dumps(
+            args,
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+            default=str,
+        )
+        return RawStepFeatures(
+            thought_length=float(len(thought)),
+            tool_hash=triple_hash_vector(tool),
+            args_hash=triple_hash_vector(serialized_args),
+            observation_length=float(len(observation)),
+            execution_time=execution_time,
+            has_error=has_error,
+        )
+
+    def transform_history(self, raw_features: list[RawStepFeatures]) -> list[np.ndarray]:
+        """Fit scalar statistics on prior steps and re-encode the full history.
+
+        The newest step is excluded from fitting so an outlier cannot weaken its
+        own distance. Every step is then transformed with the same statistics.
+        """
+        if not raw_features:
+            return []
+
+        reference = raw_features[:-1]
+        thought_z = self._standardize(
+            [item.thought_length for item in raw_features],
+            [item.thought_length for item in reference],
+        )
+        observation_z = self._standardize(
+            [item.observation_length for item in raw_features],
+            [item.observation_length for item in reference],
+        )
+        execution_z = self._standardize(
+            [item.execution_time for item in raw_features],
+            [item.execution_time for item in reference],
+        )
+
+        encoded = []
+        for index, item in enumerate(raw_features):
+            vector = np.concatenate(
+                [
+                    np.array([self.weights.thought * thought_z[index]]),
+                    self.weights.tool * item.tool_hash,
+                    self.weights.args * item.args_hash,
+                    np.array(
+                        [
+                            self.weights.observation * observation_z[index],
+                            self.weights.execution * execution_z[index],
+                            self.weights.error * float(item.has_error),
+                        ]
+                    ),
+                ]
+            ).astype(float)
+            if vector.shape != (self.n_dims,):
+                message = f"Expected {self.n_dims} features, got {vector.shape}"
+                raise RuntimeError(message)
+            encoded.append(vector)
+        return encoded
+
+    def _standardize(self, values: list[float], reference: list[float]) -> np.ndarray:
+        logged_values = np.log1p(np.maximum(np.asarray(values, dtype=float), 0.0))
+        if len(reference) < self.scalar_warmup:
+            return np.zeros_like(logged_values)
+
+        logged_reference = np.log1p(np.maximum(np.asarray(reference, dtype=float), 0.0))
+        std = float(np.std(logged_reference, ddof=1))
+        if not math.isfinite(std) or std < self.scalar_eps:
+            return np.zeros_like(logged_values)
+
+        mean = float(np.mean(logged_reference))
+        standardized = (logged_values - mean) / math.sqrt(std * std + self.scalar_eps)
+        return np.clip(standardized, -self.scalar_clip, self.scalar_clip)
+
+
+@dataclass
+class MotifCluster:
+    size: int
+    starts: set[int]
+    max_distance: float
+
+
+class MatrixProfileBasedBrain:
+    """Detect approximate action motifs with a multidimensional matrix profile.
+
+    Duplicate and failure events remain deterministic. Loop and macro events use
+    the full 36-dimensional, non-normalized feature matrix.
+    """
+
+    def __init__(
+        self,
+        window_sizes: tuple[int, ...] = (3, 5, 8),
+        repeat_times_for_loop: int = 3,
+        min_windows_for_macro: int = 3,
+        loop_distance_threshold: float = 1.10,
+        min_actions_before_loop: int = 15,
+        loop_cooldown_steps: int = 12,
+        loop_pattern_similarity_suppression: float = 0.67,
+        macro_distance_threshold: float = 1.00,
+        macro_hard_distance_threshold: float = 1.25,
+        min_tool_similarity_for_macro: float = 0.50,
+        min_argument_structure_similarity_for_macro: float = 0.40,
+        max_history: int = 500,
+        weights: FeatureWeights | None = None,
+        offline: bool = False,
+        language: str = "python",
+    ) -> None:
+        if not window_sizes or any(size < 3 for size in window_sizes):
+            message = "window_sizes must contain integers >= 3"
+            raise ValueError(message)
+        if repeat_times_for_loop < 2:
+            message = "repeat_times_for_loop must be >= 2"
+            raise ValueError(message)
+        if min_windows_for_macro < 2:
+            message = "min_windows_for_macro must be >= 2"
+            raise ValueError(message)
+        if loop_cooldown_steps < 0:
+            message = "loop_cooldown_steps must be >= 0"
+            raise ValueError(message)
+        if min_actions_before_loop < 0:
+            message = "min_actions_before_loop must be >= 0"
+            raise ValueError(message)
+        if not 0.0 <= loop_pattern_similarity_suppression <= 1.0:
+            message = "loop_pattern_similarity_suppression must be between 0 and 1"
+            raise ValueError(message)
+        if not 0.0 <= min_tool_similarity_for_macro <= 1.0:
+            message = "min_tool_similarity_for_macro must be between 0 and 1"
+            raise ValueError(message)
+        if not 0.0 <= min_argument_structure_similarity_for_macro <= 1.0:
+            message = "min_argument_structure_similarity_for_macro must be between 0 and 1"
+            raise ValueError(message)
+        required_history = max(
+            2 * max(window_sizes) + 1,
+            repeat_times_for_loop * max(window_sizes),
+        )
+        if max_history < required_history:
+            message = f"max_history must be >= {required_history} for the configured windows"
+            raise ValueError(message)
+
+        self.window_sizes = tuple(sorted(set(window_sizes)))
+        self.repeat_times_for_loop = repeat_times_for_loop
+        self.min_windows_for_macro = min_windows_for_macro
+        self.loop_distance_threshold = loop_distance_threshold
+        self.min_actions_before_loop = min_actions_before_loop
+        self.loop_cooldown_steps = loop_cooldown_steps
+        self.loop_pattern_similarity_suppression = loop_pattern_similarity_suppression
+        self.macro_distance_threshold = macro_distance_threshold
+        self.macro_hard_distance_threshold = macro_hard_distance_threshold
+        self.min_tool_similarity_for_macro = min_tool_similarity_for_macro
+        self.min_argument_structure_similarity_for_macro = min_argument_structure_similarity_for_macro
+        self.max_history = max_history
+        self.offline = offline
+        self.language = language
+        self.featurizer = StepFeaturizer(weights)
+        self.reset()
+
+    def reset(self) -> None:
+        self.actions: list[dict[str, Any]] = []
+        self.tools: list[str] = []
+        self.raw_features: list[RawStepFeatures] = []
+        self.features: list[np.ndarray] = []
+        self.total_actions_seen = 0
+        self.score_history: dict[int, list[float]] = {size: [] for size in self.window_sizes}
+        self.motif_adjacency: dict[int, dict[int, set[int]]] = {size: {} for size in self.window_sizes}
+        self.last_loop_step = -self.loop_cooldown_steps
+        self.reported_loop_patterns: list[Pattern] = []
+        self.suggested_macro_clusters: list[set[int]] = []
+
+    def inspect(self, action: dict[str, Any]) -> list[dict[str, Any]]:
+        """Inspect a proposed action without updating detector state."""
+        return []
+
+    def analyze(self, action: dict[str, Any]) -> list[dict[str, Any]]:
+        if not action:
+            return []
+
+        normalized = self._normalize_action(action)
+        if normalized is None:
+            return []
+
+        events: list[dict[str, Any]] = []
+        duplicate = self._check_exact_duplicate_action(normalized)
+        if duplicate:
+            events.append(duplicate)
+
+        error_type = action_error_type(normalized, language=self.language)
+        if error_type != "none":
+            events.append(
+                {
+                    "type": "failed_action",
+                    "error_type": error_type,
+                    "tool": normalized["tool"],
+                }
+            )
+
+        self.actions.append(normalized)
+        self.tools.append(str(normalized["tool"]))
+        self.total_actions_seen += 1
+        has_error = error_type != "none" or bool(normalized.get("has_error", False))
+        self.raw_features.append(self.featurizer.extract(normalized, has_error=has_error))
+        self._trim_history()
+        self.features = self.featurizer.transform_history(self.raw_features)
+
+        profiles = self._update_current_profiles()
+        loop = self._maybe_detect_tail_loop(profiles)
+        if loop:
+            events.append(loop)
+
+        macro = self._maybe_suggest_macro(profiles)
+        if macro:
+            events.append(macro)
+
+        return events
+
+    def snapshot(self) -> dict[str, Any]:
+        return {
+            "actions": self.actions,
+            "tools": self.tools,
+            "features": [feature.tolist() for feature in self.features],
+            "score_history": self.score_history,
+        }
+
+    def _normalize_action(self, action: dict[str, Any]) -> dict[str, Any] | None:
+        raw_action = action.get("raw_action")
+        tool = action.get("tool")
+        if isinstance(raw_action, str) and not raw_action.strip():
+            return {
+                **action,
+                "tool": EMPTY_ACTION_TOOL,
+                "args": {},
+                "raw_action": "",
+            }
+        if not tool or not raw_action:
+            return None
+        return action
+
+    def _check_exact_duplicate_action(self, current: dict[str, Any]) -> dict[str, Any] | None:
+        if not self.actions:
+            return None
+        previous = self.actions[-1]
+        if self._action_identity(previous) != self._action_identity(current):
+            return None
+        return {
+            "type": "duplicate_action",
+            "current": current,
+            "previous": previous,
+        }
+
+    @staticmethod
+    def _action_identity(action: dict[str, Any]) -> tuple[Any, Any, Any]:
+        return (
+            action.get("tool"),
+            action.get("args"),
+            action.get("raw_action"),
+        )
+
+    def _trim_history(self) -> None:
+        overflow = len(self.raw_features) - self.max_history
+        if overflow <= 0:
+            return
+        del self.actions[:overflow]
+        del self.tools[:overflow]
+        del self.raw_features[:overflow]
+        self.motif_adjacency = {size: {} for size in self.window_sizes}
+        self.suggested_macro_clusters.clear()
+
+    def _update_current_profiles(self) -> dict[int, tuple[float, int]]:
+        """Compute the newest exact, full-dimensional non-normalized profile values."""
+        profiles: dict[int, tuple[float, int]] = {}
+        count = len(self.features)
+        for size in self.window_sizes:
+            current_start = count - size
+            if current_start < size:
+                continue
+
+            distances = [
+                (self._window_distance(start, current_start, size), start) for start in range(current_start - size + 1)
+            ]
+            profile_value, nearest_start = min(distances)
+            profiles[size] = (profile_value, nearest_start)
+            self.score_history[size].append(profile_value)
+
+            adjacency = self.motif_adjacency[size]
+            for distance, start in distances:
+                if distance > self.macro_hard_distance_threshold:
+                    continue
+                if self._tool_similarity(start, current_start, size) < self.min_tool_similarity_for_macro:
+                    continue
+                adjacency.setdefault(start, set()).add(current_start)
+                adjacency.setdefault(current_start, set()).add(start)
+        return profiles
+
+    def _maybe_detect_tail_loop(
+        self,
+        profiles: dict[int, tuple[float, int]],
+    ) -> dict[str, Any] | None:
+        candidates: list[tuple[float, int, Pattern]] = []
+        count = len(self.features)
+        if self.total_actions_seen < self.min_actions_before_loop:
+            return None
+
+        for size in self.window_sizes:
+            required = size * self.repeat_times_for_loop
+            if count < required or size not in profiles:
+                continue
+
+            starts = [count - required + offset * size for offset in range(self.repeat_times_for_loop)]
+            distances = [
+                self._window_distance(starts[left], starts[right], size)
+                for left in range(self.repeat_times_for_loop)
+                for right in range(left + 1, self.repeat_times_for_loop)
+            ]
+            loop_score = max(distances)
+            if loop_score > self.loop_distance_threshold:
+                continue
+
+            pattern = tuple(self.tools[starts[-1] : starts[-1] + size])
+            candidates.append((loop_score, size, pattern))
+
+        if not candidates:
+            return None
+
+        score, size, pattern = min(candidates, key=lambda item: (item[1], item[0]))
+        current_step = len(self.features)
+        if not self.offline and self.total_actions_seen - self.last_loop_step < self.loop_cooldown_steps:
+            return None
+        if not self.offline and any(
+            self._sequence_similarity(pattern, previous) >= self.loop_pattern_similarity_suppression
+            for previous in self.reported_loop_patterns
+        ):
+            return None
+
+        required = size * self.repeat_times_for_loop
+        starts = [current_step - required + offset * size for offset in range(self.repeat_times_for_loop)]
+        representative_start = self._window_medoid(starts, size)
+        pattern = tuple(self.tools[representative_start : representative_start + size])
+        if not self.offline:
+            self.last_loop_step = self.total_actions_seen
+            self.reported_loop_patterns.append(pattern)
+        return {
+            "type": "loop_action",
+            "production": f"matrix_profile_m{size}",
+            "repeat_times": self.repeat_times_for_loop,
+            "pattern": list(pattern),
+            "score": score,
+            "window_starts": starts,
+            "representative_start": representative_start,
+            "representative_actions": [
+                action["raw_action"] for action in self.actions[representative_start : representative_start + size]
+            ],
+        }
+
+    def _maybe_suggest_macro(
+        self,
+        profiles: dict[int, tuple[float, int]],
+    ) -> dict[str, Any] | None:
+        candidates: list[tuple[float, int, MotifCluster]] = []
+
+        for size in profiles:
+            current_start = len(self.features) - size
+            cluster = self._current_motif_cluster(size, current_start)
+            if cluster is None or len(cluster.starts) < self.min_windows_for_macro:
+                continue
+            if cluster.max_distance > self.macro_hard_distance_threshold:
+                continue
+            mean_distance = self._cluster_mean_distance(cluster)
+            if mean_distance > self.macro_distance_threshold:
+                continue
+            if self._macro_argument_structure_similarity(cluster) < self.min_argument_structure_similarity_for_macro:
+                continue
+            if not self.offline and self._already_suggested(size, cluster.starts):
+                continue
+            candidates.append((mean_distance, size, cluster))
+
+        if not candidates:
+            return None
+
+        ranked = sorted(
+            candidates,
+            key=lambda item: (len(item[2].starts), item[1], -item[0]),
+            reverse=True,
+        )
+        selected: tuple[float, int, MotifCluster, Pattern, str] | None = None
+        for mean_distance, size, cluster in ranked:
+            medoid_start = self._cluster_medoid(cluster)
+            pattern = tuple(self.tools[medoid_start : medoid_start + size])
+            if not self._is_reusable_macro_pattern(pattern):
+                continue
+            if self._window_has_edit_then_validation(medoid_start, size):
+                selected = (mean_distance, size, cluster, pattern, "edit_or_validation")
+                break
+            if self._cluster_has_stable_specific_query(cluster):
+                selected = (mean_distance, size, cluster, pattern, "stable_specific_query")
+                break
+        if selected is None:
+            return None
+        mean_distance, size, cluster, pattern, workflow_kind = selected
+
+        representative_start = self._cluster_medoid(cluster)
+        signature = self._macro_signature(size, cluster.starts)
+        if not self.offline:
+            self.suggested_macro_clusters.append(signature)
+        return {
+            "type": "macro_candidate",
+            "pattern": list(pattern),
+            "count": len(cluster.starts),
+            "suggested_name": self._suggested_name(pattern),
+            "score": mean_distance,
+            "workflow_kind": workflow_kind,
+            "argument_structure_similarity": self._macro_argument_structure_similarity(cluster),
+            "window_starts": sorted(cluster.starts),
+            "representative_start": representative_start,
+            "representative_actions": [
+                action["raw_action"] for action in self.actions[representative_start : representative_start + size]
+            ],
+        }
+
+    def _current_motif_cluster(self, size: int, current_start: int) -> MotifCluster | None:
+        adjacency = self.motif_adjacency[size]
+        if current_start not in adjacency:
+            return None
+
+        component = {current_start}
+        stack = [current_start]
+        while stack:
+            node = stack.pop()
+            for neighbor in adjacency.get(node, set()):
+                if neighbor in component:
+                    continue
+                component.add(neighbor)
+                stack.append(neighbor)
+
+        historical = {start for start in component if start <= current_start - size}
+        non_overlapping = self._select_non_overlapping(historical, size)
+        non_overlapping.add(current_start)
+        if len(non_overlapping) < 2:
+            return None
+        distances = [
+            self._window_distance(left, right, size)
+            for left in sorted(non_overlapping)
+            for right in sorted(non_overlapping)
+            if left < right
+        ]
+        return MotifCluster(
+            size=size,
+            starts=non_overlapping,
+            max_distance=max(distances),
+        )
+
+    @staticmethod
+    def _select_non_overlapping(starts: set[int], size: int) -> set[int]:
+        selected: set[int] = set()
+        last_end = -1
+        for start in sorted(starts):
+            if start < last_end:
+                continue
+            selected.add(start)
+            last_end = start + size
+        return selected
+
+    def _cluster_mean_distance(self, cluster: MotifCluster) -> float:
+        medoid = self._cluster_medoid(cluster)
+        distances = [self._window_distance(medoid, start, cluster.size) for start in cluster.starts if start != medoid]
+        return float(np.mean(distances)) if distances else 0.0
+
+    def _cluster_medoid(self, cluster: MotifCluster) -> int:
+        starts = sorted(cluster.starts)
+        return min(
+            starts,
+            key=lambda candidate: sum(
+                self._window_distance(candidate, other, cluster.size) for other in starts if other != candidate
+            ),
+        )
+
+    def _macro_argument_structure_similarity(self, cluster: MotifCluster) -> float:
+        representative = self._cluster_medoid(cluster)
+        reference = [
+            self._argument_structure(action) for action in self.actions[representative : representative + cluster.size]
+        ]
+        comparisons = 0
+        matches = 0
+        for start in cluster.starts:
+            if start == representative:
+                continue
+            candidate = [self._argument_structure(action) for action in self.actions[start : start + cluster.size]]
+            comparisons += cluster.size
+            matches += sum(left == right for left, right in zip(reference, candidate, strict=True))
+        return matches / comparisons if comparisons else 1.0
+
+    @staticmethod
+    def _argument_structure(action: dict[str, Any]) -> tuple[Any, ...]:
+        args = action.get("args")
+        if isinstance(args, dict):
+            keys = tuple(sorted(str(key) for key in args))
+            command = str(args.get("command") or "")
+            path = str(args.get("path") or "")
+            suffix = path.rsplit(".", 1)[-1].lower() if "." in path.rsplit("/", 1)[-1] else ""
+            flags = tuple(sorted((str(key), value) for key, value in args.items() if isinstance(value, bool)))
+            return ("dict", keys, command, suffix, flags)
+        if isinstance(args, str):
+            try:
+                tokens = shlex.split(args)
+            except ValueError:
+                tokens = args.split()
+            modes = tuple(marker for marker in ("-c", "-m", "pytest", "unittest", "tox") if marker in tokens)
+            suffixes = tuple(
+                sorted(
+                    {
+                        token.rsplit(".", 1)[-1].lower()
+                        for token in tokens
+                        if "." in token.rsplit("/", 1)[-1] and len(token.rsplit(".", 1)[-1]) <= 8
+                    }
+                )
+            )
+            redirection = any(marker in args for marker in (">", "|", "<<"))
+            return ("string", modes, suffixes, redirection)
+        return (type(args).__name__,)
+
+    def _window_has_edit_then_validation(self, start: int, size: int) -> bool:
+        window = self.actions[start : start + size]
+        return any(
+            self._is_edit_action(action) and any(self._is_validation_action(later) for later in window[index + 1 :])
+            for index, action in enumerate(window)
+        )
+
+    @staticmethod
+    def _is_edit_action(action: dict[str, Any]) -> bool:
+        tool = str(action.get("tool") or "")
+        args = action.get("args")
+        if tool in {"edit", "create"}:
+            return True
+        if tool == "str_replace_editor" and isinstance(args, dict):
+            return str(args.get("command") or "") in {"create", "insert", "str_replace"}
+        return False
+
+    @staticmethod
+    def _is_validation_action(action: dict[str, Any]) -> bool:
+        tool = str(action.get("tool") or "")
+        return tool.startswith(("bash-python", "bash-pytest", "bash-./")) or tool in {
+            "bash-make",
+            "bash-tox",
+        }
+
+    def _cluster_has_stable_specific_query(self, cluster: MotifCluster) -> bool:
+        windows = [self.actions[start : start + cluster.size] for start in sorted(cluster.starts)]
+        if not all(all(self._is_read_or_search_action(action) for action in window) for window in windows):
+            return False
+        if not any(self._is_search_action(action) for window in windows for action in window):
+            return False
+
+        term_sets = [{term for action in window for term in self._target_terms(action)} for window in windows]
+        return bool(term_sets) and all(term_sets) and bool(set.intersection(*term_sets))
+
+    @staticmethod
+    def _is_read_or_search_action(action: dict[str, Any]) -> bool:
+        tool = str(action.get("tool") or "")
+        args = action.get("args")
+        if tool in {"open", "goto", "scroll_down", "scroll_up", "search_file", "search_dir", "find_file"}:
+            return True
+        if tool == "str_replace_editor" and isinstance(args, dict):
+            return str(args.get("command") or "view") == "view"
+        return tool in {
+            "bash-cat",
+            "bash-find",
+            "bash-grep",
+            "bash-head",
+            "bash-less",
+            "bash-ls",
+            "bash-rg",
+            "bash-tail",
+        }
+
+    @staticmethod
+    def _is_search_action(action: dict[str, Any]) -> bool:
+        return str(action.get("tool") or "") in {
+            "search_file",
+            "search_dir",
+            "find_file",
+            "bash-find",
+            "bash-grep",
+            "bash-rg",
+        }
+
+    @staticmethod
+    def _target_terms(action: dict[str, Any]) -> set[str]:
+        args = action.get("args")
+        texts: list[str] = []
+        if isinstance(args, dict):
+            for key in ("query", "pattern", "needle"):
+                if args.get(key):
+                    texts.append(str(args[key]))
+            if args.get("path"):
+                texts.append(str(args["path"]).rsplit("/", 1)[-1])
+        elif isinstance(args, str):
+            try:
+                tokens = shlex.split(args)
+            except ValueError:
+                tokens = args.split()
+            texts.extend(
+                token.rsplit("/", 1)[-1]
+                for token in tokens[1:]
+                if token and not token.startswith("-") and token not in {"2>&1", "|"}
+            )
+        else:
+            texts.append(str(args))
+
+        text = " ".join(texts)
+        stopwords = {
+            "bash",
+            "command",
+            "false",
+            "file",
+            "find",
+            "grep",
+            "head",
+            "index",
+            "none",
+            "path",
+            "python",
+            "range",
+            "search",
+            "tail",
+            "true",
+            "view",
+        }
+        return {
+            token.lower() for token in re.findall(r"[A-Za-z_][A-Za-z0-9_]{2,}", text) if token.lower() not in stopwords
+        }
+
+    def _window_distance(self, left: int, right: int, size: int) -> float:
+        left_window = np.vstack(self.features[left : left + size])
+        right_window = np.vstack(self.features[right : right + size])
+        return float(np.linalg.norm(left_window - right_window) / math.sqrt(size))
+
+    def _window_medoid(self, starts: list[int], size: int) -> int:
+        return min(
+            starts,
+            key=lambda candidate: sum(
+                self._window_distance(candidate, other, size) for other in starts if other != candidate
+            ),
+        )
+
+    def _tool_similarity(self, left: int, right: int, size: int) -> float:
+        left_tools = self.tools[left : left + size]
+        right_tools = self.tools[right : right + size]
+        return self._sequence_similarity(tuple(left_tools), tuple(right_tools))
+
+    def _sequence_similarity(self, left: Pattern, right: Pattern) -> float:
+        distance = self._levenshtein_distance(list(left), list(right))
+        return 1.0 - distance / max(len(left), len(right), 1)
+
+    @staticmethod
+    def _is_reusable_macro_pattern(pattern: Pattern) -> bool:
+        forbidden = {
+            EMPTY_ACTION_TOOL,
+            "bash-apt",
+            "bash-apt-get",
+            "bash-conda",
+            "bash-submit",
+            "bash-exit_cost",
+            "bash-exit_format",
+            "bash-pip",
+        }
+        families = {MatrixProfileBasedBrain._canonical_tool_family(tool) for tool in pattern}
+        return len(families) > 1 and not any(tool in forbidden for tool in pattern)
+
+    @staticmethod
+    def _canonical_tool_family(tool: str) -> str:
+        if re.fullmatch(r"bash-python(?:\d+(?:\.\d+)*)?", tool):
+            return "bash-python"
+        if tool.startswith("bash-PYTHONPATH="):
+            return "bash-python"
+        return tool
+
+    @staticmethod
+    def _levenshtein_distance(left: list[str], right: list[str]) -> int:
+        previous = list(range(len(right) + 1))
+        for left_index, left_value in enumerate(left, start=1):
+            current = [left_index]
+            for right_index, right_value in enumerate(right, start=1):
+                current.append(
+                    min(
+                        current[-1] + 1,
+                        previous[right_index] + 1,
+                        previous[right_index - 1] + int(left_value != right_value),
+                    )
+                )
+            previous = current
+        return previous[-1]
+
+    def _already_suggested(self, size: int, starts: set[int]) -> bool:
+        signature = self._macro_signature(size, starts)
+        return any(
+            len(signature & previous) / len(signature | previous) >= 0.5 for previous in self.suggested_macro_clusters
+        )
+
+    @staticmethod
+    def _macro_signature(size: int, starts: set[int]) -> set[int]:
+        return {action_index for start in starts for action_index in range(start, start + size)}
+
+    @staticmethod
+    def _suggested_name(pattern: Pattern) -> str:
+        parts = [re.sub(r"[^a-zA-Z0-9]+", "_", tool).strip("_") or "action" for tool in pattern[:4]]
+        counts = Counter(parts)
+        if len(counts) == 1:
+            parts = [parts[0], "workflow"]
+        return "custom_" + "_".join(parts)

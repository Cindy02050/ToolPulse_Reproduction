+    rendered: list[str] = []
+    monkeypatch.setattr(
+        builder,
+        "_render_prompt",
+        lambda event, entry, task_description, recent_trajectory: rendered.append(event.get("type")) or "P",
+    )
+    out = builder.build([{"type": "blind_action", "tool": "edit", "path": "a.py"}], "t", [])
+    assert out == ["[llm-hint stub:blind_action]"]
+    assert rendered == ["blind_action"]

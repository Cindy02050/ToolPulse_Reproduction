+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Any
+
+import numpy as np
+from sksequitur import Grammar, Parser, Production
+
+from sweagent.agent.algorithm.matrix_profile import FeatureWeights, RawStepFeatures, StepFeaturizer
+from sweagent.agent.algorithm.utils.action_error import action_error_type, observation_error_fingerprint
+from sweagent.agent.algorithm.utils.action_semantic import (
+    action_semantic_label,
+    action_target_file,
+    is_blind_patch_action,
+    record_read_file,
+    reset_action_semantic_state,
+    semantic_pattern_display,
+)
+
+EMPTY_ACTION_TOOL = "<empty_action>"
+Pattern = tuple[str, ...]
+FailureSignature = tuple[str, str, str]
+
+
+@dataclass
+class FailureCluster:
+    count: int
+    last_seen_step: int
+
+
+class MultiGranularityBrain:
+    """Detect repeated tool-use patterns with hybird algorithm."""
+
+    def __init__(
+        self,
+        min_pattern_len: int = 3,
+        repeat_times_for_loop: int = 3,
+        failed_action_repeat_threshold: int = 2,
+        failed_action_window_steps: int = 8,
+        window_sizes: tuple[int, ...] = (3, 5, 8),
+        repeat_times_for_stalled: int = 3,
+        stalled_distance_threshold: float = 1.10,
+        min_actions_before_stalled: int = 15,
+        stalled_cooldown_steps: int = 12,
+        stalled_pattern_similarity_suppression: float = 0.67,
+        max_history: int = 500,
+        weights: FeatureWeights | None = None,
+        offline: bool = False,
+        language: str = "python",
+    ) -> None:
+        if repeat_times_for_loop < 2:
+            message = "repeat_times_for_loop must be >= 2"
+            raise ValueError(message)
+        if failed_action_repeat_threshold < 1:
+            message = "failed_action_repeat_threshold must be >= 1"
+            raise ValueError(message)
+        if failed_action_window_steps < 1:
+            message = "failed_action_window_steps must be >= 1"
+            raise ValueError(message)
+        if not window_sizes or any(size < 3 for size in window_sizes):
+            message = "window_sizes must contain integers >= 3"
+            raise ValueError(message)
+        if repeat_times_for_stalled < 2:
+            message = "repeat_times_for_stalled must be >= 2"
+            raise ValueError(message)
+        if min_actions_before_stalled < 0:
+            message = "min_actions_before_stalled must be >= 0"
+            raise ValueError(message)
+        if stalled_cooldown_steps < 0:
+            message = "stalled_cooldown_steps must be >= 0"
+            raise ValueError(message)
+        if not 0.0 <= stalled_pattern_similarity_suppression <= 1.0:
+            message = "stalled_pattern_similarity_suppression must be between 0 and 1"
+            raise ValueError(message)
+        required_history = max(
+            2 * max(window_sizes) + 1,
+            repeat_times_for_stalled * max(window_sizes),
+        )
+        if max_history < required_history:
+            message = f"max_history must be >= {required_history} for the configured windows"
+            raise ValueError(message)
+
+        self.min_pattern_len = min_pattern_len
+        self.repeat_times_for_loop = repeat_times_for_loop
+        self.failed_action_repeat_threshold = failed_action_repeat_threshold
+        self.failed_action_window_steps = failed_action_window_steps
+        self.window_sizes = tuple(sorted(set(window_sizes)))
+        self.repeat_times_for_stalled = repeat_times_for_stalled
+        self.stalled_distance_threshold = stalled_distance_threshold
+        self.min_actions_before_stalled = min_actions_before_stalled
+        self.stalled_cooldown_steps = stalled_cooldown_steps
+        self.stalled_pattern_similarity_suppression = stalled_pattern_similarity_suppression
+        self.max_history = max_history
+        self.offline = offline
+        self.language = language
+        self.featurizer = StepFeaturizer(weights)
+        self.reset()
+
+    def reset(self) -> None:
+        reset_action_semantic_state()
+        self.parser = Parser()
+        self.actions: list[dict[str, Any]] = []
+        self.tools: list[str] = []
+        self.semantic_labels: list[str] = []
+        self.raw_features: list[RawStepFeatures] = []
+        self.features: list[np.ndarray] = []
+        self.total_actions_seen = 0
+        self.failure_clusters: dict[FailureSignature, FailureCluster] = {}
+        self.score_history: dict[int, list[float]] = {size: [] for size in self.window_sizes}
+        self.repeated_production_reported: set[Pattern] = set()
+        self.last_stalled_step = -self.stalled_cooldown_steps
+        self.reported_stalled_patterns: list[Pattern] = []
+
+    def inspect(self, action: dict[str, Any]) -> list[dict[str, Any]]:
+        """Inspect a proposed action without updating detector state."""
+        if not action:
+            return []
+
+        tool = action.get("tool")
+        raw_action = action.get("raw_action")
+        semantic_label = action_semantic_label(action, record_edit=False, language=self.language)
+        if semantic_label == "SKIP":
+            return []
+        if semantic_label == "Emp":
+            action = {
+                **action,
+                "tool": EMPTY_ACTION_TOOL,
+                "args": {},
+                "raw_action": "",
+            }
+        elif not tool or not raw_action:
+            return []
+
+        events: list[dict[str, Any]] = []
+
+        blind_event = self._check_blind_action(action, semantic_label)
+        if blind_event:
+            events.append(blind_event)
+
+        return events
+
+    def analyze(self, action: dict[str, Any]) -> list[dict[str, Any]]:
+        """Analyze one parsed action and return structured events."""
+        if not action:
+            return []
+
+        tool = action.get("tool")
+        raw_action = action.get("raw_action")
+        semantic_label = action_semantic_label(action, language=self.language)
+        if semantic_label == "SKIP":
+            return []
+        if semantic_label == "Emp":
+            action = {
+                **action,
+                "tool": EMPTY_ACTION_TOOL,
+                "args": {},
+                "raw_action": "",
+            }
+            tool = EMPTY_ACTION_TOOL
+        elif not tool or not raw_action:
+            return []
+
+        events: list[dict[str, Any]] = []
+
+        duplicate_event = self._check_exact_duplicate_action(action)
+        if duplicate_event:
+            events.append(duplicate_event)
+
+        record_read_file(action, semantic_label)
+
+        error_type = action_error_type(action, language=self.language)
+        failed_event = self._maybe_failed_action(action, str(tool), semantic_label, error_type)
+        if failed_event:
+            events.append(failed_event)
+
+        self.actions.append(action)
+        self.tools.append(str(tool))
+        self.semantic_labels.append(semantic_label)
+        self.parser.feed([semantic_label])
+        self.total_actions_seen += 1
+        has_error = error_type != "none" or bool(action.get("has_error", False))
+        self.raw_features.append(self.featurizer.extract(action, has_error=has_error))
+        self._trim_history()
+        self.features = self.featurizer.transform_history(self.raw_features)
+
+        loop_event = self._check_tail_repeated_production(self.current_grammar())
+        if loop_event:
+            events.append(loop_event)
+
+        profiles = self._update_current_profiles()
+        stalled_event = self._maybe_detect_tail_stalled(profiles)
+        if stalled_event:
+            events.append(stalled_event)
+
+        return events
+
+    def snapshot(self) -> dict[str, Any]:
+        return {
+            "actions": self.actions,
+            "tools": self.tools,
+            "semantic_labels": self.semantic_labels,
+            "features": [feature.tolist() for feature in self.features],
+            "score_history": self.score_history,
+        }
+
+    def current_grammar(self) -> Grammar:
+        return Grammar(self.parser.tree)
+
+    def _check_blind_action(self, action: dict[str, Any], semantic_label: str) -> dict[str, Any] | None:
+        if not is_blind_patch_action(action, semantic_label):
+            return None
+
+        return {
+            "type": "blind_action",
+            "tool": action.get("tool"),
+            "path": action_target_file(action),
+            "raw_action": action.get("raw_action"),
+        }
+
+    def _maybe_failed_action(
+        self,
+        action: dict[str, Any],
+        tool: str,
+        semantic_label: str,
+        error_type: str,
+    ) -> dict[str, Any] | None:
+        current_step = self.total_actions_seen + 1
+        self._expire_failure_clusters(current_step)
+
+        if semantic_label in {"P", "Ps", "Pi", "Pr", "E"}:
+            self.failure_clusters.clear()
+        elif semantic_label == "Vp" and error_type == "none" and not action.get("has_error", False):
+            self.failure_clusters = {
+                signature: cluster for signature, cluster in self.failure_clusters.items() if signature[0] != tool
+            }
+
+        if error_type == "none":
+            return None
+
+        fingerprint = observation_error_fingerprint(str(action.get("observation") or ""), error_type)
+        if fingerprint is None:
+            return None
+
+        signature = (tool, error_type, fingerprint)
+        previous = self.failure_clusters.get(signature)
+        cluster = FailureCluster(
+            count=1 if previous is None else previous.count + 1,
+            last_seen_step=current_step,
+        )
+        if cluster.count < self.failed_action_repeat_threshold:
+            self.failure_clusters[signature] = cluster
+            return None
+
+        self.failure_clusters.pop(signature, None)
+        return {
+            "type": "failed_action",
+            "error_type": error_type,
+            "tool": tool,
+            "error_fingerprint": fingerprint,
+            "repeat_times": self.failed_action_repeat_threshold,
+        }
+
+    def _expire_failure_clusters(self, current_step: int) -> None:
+        self.failure_clusters = {
+            signature: cluster
+            for signature, cluster in self.failure_clusters.items()
+            if current_step - cluster.last_seen_step <= self.failed_action_window_steps
+        }
+
+    def _check_exact_duplicate_action(self, current: dict[str, Any]) -> dict[str, Any] | None:
+        if len(self.actions) < 2:
+            return None
+
+        previous = self.actions[-1]
+        before_previous = self.actions[-2]
+        current_identity = self._action_identity(current)
+        if (
+            self._action_identity(previous) == current_identity
+            and self._action_identity(before_previous) == current_identity
+        ):
+            return {
+                "type": "duplicate_action",
+                "current": current,
+                "previous": previous,
+            }
+
+        return None
+
+    @staticmethod
+    def _action_identity(action: dict[str, Any]) -> tuple[Any, Any, Any]:
+        return (
+            action.get("tool"),
+            action.get("args"),
+            action.get("raw_action"),
+        )
+
+    def _trim_history(self) -> None:
+        overflow = len(self.raw_features) - self.max_history
+        if overflow <= 0:
+            return
+        del self.actions[:overflow]
+        del self.tools[:overflow]
+        del self.semantic_labels[:overflow]
+        del self.raw_features[:overflow]
+        self.parser = Parser()
+        if self.semantic_labels:
+            self.parser.feed(self.semantic_labels)
+
+    def _check_tail_repeated_production(self, grammar: Grammar) -> dict[str, Any] | None:
+        start_body = grammar[Production(0)]
+
+        if len(start_body) < self.repeat_times_for_loop:
+            return None
+
+        tail = start_body[-self.repeat_times_for_loop :]
+
+        if not all(isinstance(item, Production) for item in tail):
+            return None
+
+        if len(set(tail)) != 1:
+            return None
+
+        repeated_prod = tail[0]
+        pattern = tuple(grammar.expand(repeated_prod))
+
+        if len(pattern) < self.min_pattern_len:
+            return None
+
+        if self._is_single_label_repetition(pattern):
+            return None
+
+        if not self.offline and pattern in self.repeated_production_reported:
+            return None
+        if not self.offline:
+            self.repeated_production_reported.add(pattern)
+
+        return {
+            "type": "loop_action",
+            "production": str(repeated_prod),
+            "repeat_times": self.repeat_times_for_loop,
+            "pattern": semantic_pattern_display(pattern),
+        }
+
+    def _update_current_profiles(self) -> dict[int, tuple[float, int]]:
+        profiles: dict[int, tuple[float, int]] = {}
+        count = len(self.features)
+        for size in self.window_sizes:
+            current_start = count - size
+            if current_start < size:
+                continue
+
+            distances = [
+                (self._window_distance(start, current_start, size), start) for start in range(current_start - size + 1)
+            ]
+            profile_value, nearest_start = min(distances)
+            profiles[size] = (profile_value, nearest_start)
+            self.score_history[size].append(profile_value)
+        return profiles
+
+    def _maybe_detect_tail_stalled(
+        self,
+        profiles: dict[int, tuple[float, int]],
+    ) -> dict[str, Any] | None:
+        candidates: list[tuple[float, int, Pattern]] = []
+        count = len(self.features)
+        if self.total_actions_seen < self.min_actions_before_stalled:
+            return None
+
+        for size in self.window_sizes:
+            required = size * self.repeat_times_for_stalled
+            if count < required or size not in profiles:
+                continue
+
+            starts = [count - required + offset * size for offset in range(self.repeat_times_for_stalled)]
+            distances = [
+                self._window_distance(starts[left], starts[right], size)
+                for left in range(self.repeat_times_for_stalled)
+                for right in range(left + 1, self.repeat_times_for_stalled)
+            ]
+            stalled_score = max(distances)
+            if stalled_score > self.stalled_distance_threshold:
+                continue
+
+            pattern = tuple(self.tools[starts[-1] : starts[-1] + size])
+            candidates.append((stalled_score, size, pattern))
+
+        if not candidates:
+            return None
+
+        score, size, pattern = min(candidates, key=lambda item: (item[1], item[0]))
+        current_step = len(self.features)
+        if not self.offline and self.total_actions_seen - self.last_stalled_step < self.stalled_cooldown_steps:
+            return None
+        if not self.offline and any(
+            self._sequence_similarity(pattern, previous) >= self.stalled_pattern_similarity_suppression
+            for previous in self.reported_stalled_patterns
+        ):
+            return None
+
+        required = size * self.repeat_times_for_stalled
+        starts = [current_step - required + offset * size for offset in range(self.repeat_times_for_stalled)]
+        representative_start = self._window_medoid(starts, size)
+        pattern = tuple(self.tools[representative_start : representative_start + size])
+        if not self.offline:
+            self.last_stalled_step = self.total_actions_seen
+            self.reported_stalled_patterns.append(pattern)
+        return {
+            "type": "stalled_action",
+            "production": size,
+            "repeat_times": self.repeat_times_for_stalled,
+            "pattern": list(pattern),
+            "score": score,
+            "window_starts": starts,
+            "representative_start": representative_start,
+            "representative_actions": [
+                action["raw_action"] for action in self.actions[representative_start : representative_start + size]
+            ],
+        }
+
+    def _window_distance(self, left: int, right: int, size: int) -> float:
+        left_window = np.vstack(self.features[left : left + size])
+        right_window = np.vstack(self.features[right : right + size])
+        return float(np.linalg.norm(left_window - right_window) / math.sqrt(size))
+
+    def _window_medoid(self, starts: list[int], size: int) -> int:
+        return min(
+            starts,
+            key=lambda candidate: sum(
+                self._window_distance(candidate, other, size) for other in starts if other != candidate
+            ),
+        )
+
+    def _sequence_similarity(self, left: Pattern, right: Pattern) -> float:
+        distance = self._levenshtein_distance(list(left), list(right))
+        return 1.0 - distance / max(len(left), len(right), 1)
+
+    @staticmethod
+    def _levenshtein_distance(left: list[str], right: list[str]) -> int:
+        previous = list(range(len(right) + 1))
+        for left_index, left_value in enumerate(left, start=1):
+            current = [left_index]
+            for right_index, right_value in enumerate(right, start=1):
+                current.append(
+                    min(
+                        current[-1] + 1,
+                        previous[right_index] + 1,
+                        previous[right_index - 1] + int(left_value != right_value),
+                    )
+                )
+            previous = current
+        return previous[-1]
+
+    @staticmethod
+    def _is_single_label_repetition(pattern: tuple[str, ...]) -> bool:
+        return len(set(pattern)) == 1
